---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CreateSessionButton from '../components/CreateSessionButton.astro';

const title = "Webhook Testing Tool — Catch, Inspect & Debug Webhooks Free | WebhookCatch";
const description = "Free webhook testing tool. Generate a unique webhook URL instantly to catch, inspect, and debug HTTP requests from Stripe, GitHub, Shopify, Discord & more. No signup required.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "WebhookCatch",
    "url": "https://webhookcatch.com",
    "description": description,
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "All",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "ratingCount": "127"
    },
    "featureList": "Webhook URL generation, HTTP request inspection, Real-time payload viewer, Header analysis, JSON body formatter, Query parameter parser"
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "WebhookCatch",
    "url": "https://webhookcatch.com",
    "logo": "https://webhookcatch.com/favicon.svg",
    "sameAs": [
      "https://github.com/Sudarshan-Works/WebhookCatch"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is a webhook?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A webhook is an automated HTTP callback that sends real-time data from one application to another when a specific event occurs. Instead of polling an API repeatedly, webhooks push data to your server the instant something happens — like a payment completing on Stripe, a commit pushed to GitHub, or an order placed on Shopify."
        }
      },
      {
        "@type": "Question",
        "name": "How do I test a webhook?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "To test a webhook, use a tool like WebhookCatch.com to generate a unique URL. Paste this URL into your webhook provider (Stripe, GitHub, Shopify, etc.) as the destination endpoint. When the provider fires an event, the request will appear in your WebhookCatch dashboard instantly — showing headers, body, method, and query parameters."
        }
      },
      {
        "@type": "Question",
        "name": "What is a webhook URL?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A webhook URL is a publicly accessible HTTP endpoint on your server that receives incoming webhook payloads. When you configure a webhook in a service like Stripe or GitHub, you provide this URL so the service knows where to send event notifications. Tools like WebhookCatch generate temporary webhook URLs for testing purposes."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between a webhook and an API?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "APIs use a pull model — your application sends a request to get data. Webhooks use a push model — the service sends data to your application automatically when an event occurs. APIs are client-initiated, while webhooks are server-initiated. Webhooks are more efficient for real-time notifications because they eliminate the need for constant polling."
        }
      },
      {
        "@type": "Question",
        "name": "How do I get a free webhook URL?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Visit WebhookCatch.com and click 'Create Webhook URL'. A unique, publicly accessible URL is generated instantly — no account or signup required. You can use this URL to receive and inspect webhook payloads from any service for free."
        }
      },
      {
        "@type": "Question",
        "name": "Are webhooks secure?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Webhooks can be made secure by using HTTPS endpoints, verifying cryptographic signatures (HMAC), and checking timestamps to prevent replay attacks. Most major providers like Stripe, GitHub, and Shopify include HMAC signatures in webhook headers so you can verify the payload wasn't tampered with."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "WebhookCatch — Free Webhook Tester",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Web",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  }
];
---

<Layout title={title} description={description}>

  {structuredData.map(sd => (
    <script type="application/ld+json" set:html={JSON.stringify(sd)} />
  ))}

  <Navbar />

  <!-- Hero -->
  <main class="hero mesh-gradient">
    <div class="hero-content">
      <div class="hero-eyebrow">
        <span class="badge-secondary text-caption-mono">Free · No signup · Open Source</span>
      </div>
      <h1 class="text-display-xl hero-title">
        Free Webhook Testing Tool
      </h1>
      <p class="text-body-lg hero-subtitle">
        Generate a unique webhook URL and inspect every incoming HTTP request in real-time — headers, body, query params, everything. The fastest way to test and debug webhooks from Stripe, GitHub, Shopify, Discord, and more.
      </p>
      <div class="hero-actions">
        <CreateSessionButton text="Create Free Webhook URL" />
      </div>
      
      <!-- Recent Webhooks (Client-side populated) -->
      <div id="recent-sessions-container" style="display: none; margin-top: 24px; animation: fadeIn 0.5s ease-out;">
        <h4 class="text-caption" style="color: var(--color-mute); margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Recent Sessions</h4>
        <div id="recent-sessions-list" style="display: flex; flex-direction: column; gap: 8px; align-items: center;"></div>
      </div>

      <p class="hero-meta text-caption" style="color: var(--color-mute); margin-top: 24px;">
        Active for 7 days · Up to 500 requests · No signup required
      </p>
    </div>
  </main>

  <script>
    // Load recent sessions from localStorage
    function loadRecentSessions() {
      try {
        const stored = localStorage.getItem('webhookcatch_recent_sessions');
        if (stored) {
          const sessions = JSON.parse(stored);
          if (sessions && sessions.length > 0) {
            const container = document.getElementById('recent-sessions-container');
            const list = document.getElementById('recent-sessions-list');
            if (container && list) {
              list.innerHTML = '';
              sessions.forEach((s) => {
                const a = document.createElement('a');
                a.href = `/${s.id}`;
                a.className = 'recent-session-link';
                
                // Format relative time
                let timeStr = '';
                const diffMs = Date.now() - s.timestamp;
                const diffMins = Math.floor(diffMs / 60000);
                const diffHours = Math.floor(diffMins / 60);
                const diffDays = Math.floor(diffHours / 24);
                
                if (diffMins < 1) timeStr = 'Just now';
                else if (diffMins < 60) timeStr = `${diffMins}m ago`;
                else if (diffHours < 24) timeStr = `${diffHours}h ago`;
                else timeStr = `${diffDays}d ago`;
                
                a.innerHTML = `
                  <div style="display: flex; align-items: center; justify-content: space-between; width: 100%; gap: 16px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-mute);">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                      <span class="text-code" style="font-size: 13px;">${s.id}</span>
                    </div>
                    <span class="text-caption" style="color: var(--color-mute);">${timeStr}</span>
                  </div>
                `;
                list.appendChild(a);
              });
              container.style.display = 'block';
            }
          }
        }
      } catch (e) {
        console.error('Failed to load recent sessions', e);
      }
    }

    // Load on mount and when returning from BFCache
    loadRecentSessions();
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) loadRecentSessions();
    });
  </script>

  <!-- Features -->
  <section class="features-section">
    <div class="section-header">
      <h2 class="text-display-md">Why developers choose WebhookCatch</h2>
      <p class="text-body-md" style="color: var(--color-body); max-width: 560px; margin: 12px auto 0;">The fastest, simplest way to test webhooks — used by developers at startups and enterprises worldwide.</p>
    </div>
    <div class="features-grid">
      <div class="feature-card card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
          </svg>
        </div>
        <h3 class="text-display-sm">Instant webhook URL generation</h3>
        <p class="text-body-md" style="color: var(--color-body);">
