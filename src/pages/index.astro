---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CreateSessionButton from '../components/CreateSessionButton.astro';

---

<Layout title="WebhookCatch - Instant, private webhook testing">

  <Navbar />

  <!-- Hero -->
  <main class="hero mesh-gradient">
    <div class="hero-content">
      <div class="hero-eyebrow">
        <span class="badge-secondary text-caption-mono">Free · No signup</span>
      </div>
      <h1 class="text-display-xl hero-title">
        Catch webhooks instantly.
      </h1>
      <p class="text-body-lg hero-subtitle">
        Generate a unique URL and inspect every incoming HTTP request in real-time — headers, body, query params, everything.
      </p>
      <div class="hero-actions">
        <CreateSessionButton text="Create Webhook URL" />
      </div>
      <p class="hero-meta text-caption" style="color: var(--color-mute); margin-top: 16px;">
        Active for 7 days · Up to 100 requests · No signup required
      </p>
    </div>
  </main>

  <!-- Features -->
  <section class="features-section">
    <div class="features-grid">
      <div class="feature-card card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
          </svg>
        </div>
        <h3 class="text-display-sm">Instant setup.</h3>
        <p class="text-body-md" style="color: var(--color-body);">
          One click to get a unique webhook URL. No signup, no configuration, no friction.
        </p>
      </div>
      <div class="feature-card card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <path d="M3 9h18"/>
            <path d="M9 21V9"/>
          </svg>
        </div>
        <h3 class="text-display-sm">Full inspection.</h3>
        <p class="text-body-md" style="color: var(--color-body);">
          View method, headers, query parameters, and body — beautifully formatted in a developer-first UI.
        </p>
      </div>
      <div class="feature-card card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <h3 class="text-display-sm">7-day sessions.</h3>
        <p class="text-body-md" style="color: var(--color-body);">
          Each webhook stays active for 7 days and captures up to 100 requests with a live countdown.
        </p>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer />
</Layout>

<style>
  /* Hero */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 128px 24px 96px;
    text-align: center;
  }

  .hero-content {
    max-width: 680px;
    animation: fadeIn 0.5s ease-out;
  }

  .hero-eyebrow {
    margin-bottom: 24px;
  }

  .hero-title {
    margin: 0 0 24px;
    color: var(--color-ink);
  }

  .hero-subtitle {
    margin: 0 0 40px;
    color: var(--color-body);
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
  }

  /* Features */
  .features-section {
    padding: 96px 24px;
    background-color: var(--color-canvas);
  }

  .features-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .feature-card {
    padding: 32px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  
  .feature-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-level-3);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-canvas-soft-2);
    border-radius: var(--radius-md);
    margin-bottom: 20px;
    color: var(--color-ink);
  }

  .feature-card h3 {
    margin: 0 0 8px;
  }

  .feature-card p {
    margin: 0;
  }

  /* Animations */
  @keyframes spinner {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  .spinner {
    animation: spinner 1s linear infinite;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-title {
      font-size: 36px;
      line-height: 40px;
      letter-spacing: -1.28px;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
