---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CreateSessionButton from '../components/CreateSessionButton.astro';

---

<Layout title="WebhookCatch - Instant, private webhook testing">

  <Navbar />

  <!-- Hero -->
  <main class="hero mesh-gradient">
    <div class="hero-content">
      <div class="hero-eyebrow">
        <span class="badge-secondary text-caption-mono">Free · No signup</span>
      </div>
      <h1 class="text-display-xl hero-title">
        Catch webhooks instantly.
      </h1>
      <p class="text-body-lg hero-subtitle">
        Generate a unique URL and inspect every incoming HTTP request in real-time — headers, body, query params, everything.
      </p>
      <div class="hero-actions">
        <CreateSessionButton text="Create Webhook URL" />
      </div>
      
      <!-- Recent Webhooks (Client-side populated) -->
      <div id="recent-sessions-container" style="display: none; margin-top: 24px; animation: fadeIn 0.5s ease-out;">
        <h4 class="text-caption" style="color: var(--color-mute); margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Recent Sessions</h4>
        <div id="recent-sessions-list" style="display: flex; flex-direction: column; gap: 8px; align-items: center;"></div>
      </div>

      <p class="hero-meta text-caption" style="color: var(--color-mute); margin-top: 24px;">
        Active for 7 days · Up to 500 requests · No signup required
      </p>
    </div>
  </main>

  <script>
    // Load recent sessions from localStorage
    function loadRecentSessions() {
      try {
        const stored = localStorage.getItem('webhookcatch_recent_sessions');
        if (stored) {
          const sessions = JSON.parse(stored);
          if (sessions && sessions.length > 0) {
            const container = document.getElementById('recent-sessions-container');
            const list = document.getElementById('recent-sessions-list');
            if (container && list) {
              list.innerHTML = '';
              sessions.forEach((s) => {
                const a = document.createElement('a');
                a.href = `/${s.id}`;
                a.className = 'recent-session-link';
                
                // Format relative time
                let timeStr = '';
                const diffMs = Date.now() - s.timestamp;
                const diffMins = Math.floor(diffMs / 60000);
                const diffHours = Math.floor(diffMins / 60);
                const diffDays = Math.floor(diffHours / 24);
                
                if (diffMins < 1) timeStr = 'Just now';
                else if (diffMins < 60) timeStr = `${diffMins}m ago`;
                else if (diffHours < 24) timeStr = `${diffHours}h ago`;
                else timeStr = `${diffDays}d ago`;
                
                a.innerHTML = `
                  <div style="display: flex; align-items: center; justify-content: space-between; width: 100%; gap: 16px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-mute);">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                      <span class="text-code" style="font-size: 13px;">${s.id}</span>
                    </div>
                    <span class="text-caption" style="color: var(--color-mute);">${timeStr}</span>
                  </div>
                `;
                list.appendChild(a);
              });
              container.style.display = 'block';
            }
          }
        }
      } catch (e) {
        console.error('Failed to load recent sessions', e);
      }
    }

    // Load on mount and when returning from BFCache
    loadRecentSessions();
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) loadRecentSessions();
    });
  </script>

  <!-- Features -->
  <section class="features-section">
    <div class="features-grid">
      <div class="feature-card card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
          </svg>
        </div>
        <h3 class="text-display-sm">Instant setup.</h3>
        <p class="text-body-md" style="color: var(--color-body);">
          One click to get a unique webhook URL. No signup, no configuration, no friction.
        </p>
      </div>
      <div class="feature-card card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <path d="M3 9h18"/>
            <path d="M9 21V9"/>
          </svg>
        </div>
        <h3 class="text-display-sm">Full inspection.</h3>
        <p class="text-body-md" style="color: var(--color-body);">
          View method, headers, query parameters, and body — beautifully formatted in a developer-first UI.
        </p>
      </div>
      <div class="feature-card card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <h3 class="text-display-sm">7-day sessions.</h3>
        <p class="text-body-md" style="color: var(--color-body);">
          Each webhook stays active for 7 days and captures up to 500 requests with a live countdown.
        </p>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer />
</Layout>

<style>
  /* Hero */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 128px 24px 96px;
    text-align: center;
  }

  .hero-content {
    max-width: 680px;
    animation: fadeIn 0.5s ease-out;
  }

  .hero-eyebrow {
    margin-bottom: 24px;
  }

  .hero-title {
    margin: 0 0 24px;
    color: var(--color-ink);
  }

  .hero-subtitle {
    margin: 0 0 40px;
    color: var(--color-body);
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
  }

  /* Features */
  .features-section {
    padding: 96px 24px;
    background-color: var(--color-canvas);
  }

  .features-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .feature-card {
    padding: 32px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  
  .feature-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-level-3);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-canvas-soft-2);
    border-radius: var(--radius-md);
    margin-bottom: 20px;
    color: var(--color-ink);
  }

  .feature-card h3 {
    margin: 0 0 8px;
  }

  .feature-card p {
    margin: 0;
  }

  /* Animations */
  @keyframes spinner {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  .spinner {
    animation: spinner 1s linear infinite;
  }

  /* Responsive */
  @media (max-width: 960px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 96px 20px 64px;
      min-height: auto;
    }

    .hero-title {
      font-size: 36px;
      line-height: 40px;
      letter-spacing: -1.28px;
    }

    .hero-subtitle {
      margin-bottom: 32px;
    }

    .features-section {
      padding: 64px 20px;
    }

    .features-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .feature-card {
      padding: 24px;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: 80px 16px 48px;
    }

    .hero-title {
      font-size: 28px;
      line-height: 32px;
      letter-spacing: -1px;
    }

    .hero-subtitle {
      font-size: 15px;
      margin-bottom: 28px;
    }

    .hero-eyebrow {
      margin-bottom: 16px;
    }

    .features-section {
      padding: 48px 16px;
    }

    .feature-card {
      padding: 20px;
    }

    .feature-icon {
      width: 40px;
      height: 40px;
      margin-bottom: 16px;
    }

    .feature-card h3 {
      font-size: 17px;
    }

    .feature-card p {
      font-size: 14px;
      line-height: 20px;
    }
  }

  .recent-session-link {
    display: flex;
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    padding: 12px 16px;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-ink);
    width: 100%;
    max-width: 320px;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .recent-session-link:hover {
    border-color: var(--color-hairline-strong);
    box-shadow: var(--shadow-level-1);
    transform: translateY(-1px);
  }
</style>
