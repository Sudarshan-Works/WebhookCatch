---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = "The Best WebhookCatcher Alternative - WebhookCatch";
const description = "Need a free alternative to WebhookCatcher? WebhookCatch offers instant URL generation, 7-day data retention for free, and requires zero signup.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": {
    "@type": "Organization",
    "name": "WebhookCatch"
  }
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Navbar />

  <main style="max-width: 900px; margin: 0 auto; padding: 100px 24px; color: var(--color-ink);">
    <div style="text-align: center; margin-bottom: 64px;">
      <div style="display: inline-flex; align-items: center; gap: 8px; background: var(--color-canvas-soft-2); padding: 4px 12px; border-radius: var(--radius-full); margin-bottom: 24px; font-size: 14px; font-family: var(--font-mono);">
        WebhookCatch vs WebhookCatcher
      </div>
      <h1 class="text-display-lg" style="margin-bottom: 24px; font-weight: 700;">The Best WebhookCatcher Alternative</h1>
      <p class="text-body-lg" style="color: var(--color-body); max-width: 600px; margin: 0 auto;">
        WebhookCatcher is a powerful platform, but if you just need to instantly inspect a payload without creating an account, WebhookCatch is the perfect, lightweight alternative.
      </p>
    </div>

    <div style="margin-bottom: 64px; overflow-x: auto; border-radius: 12px; box-shadow: var(--shadow-level-2); border: 1px solid var(--color-hairline);">
      <table style="width: 100%; border-collapse: collapse; background: var(--color-canvas); text-align: left;">
        <thead>
          <tr style="border-bottom: 1px solid var(--color-hairline); background: var(--color-canvas-soft-2);">
            <th style="padding: 16px 24px; font-weight: 600;">Feature</th>
            <th style="padding: 16px 24px; font-weight: 600;">WebhookCatcher (Hobby)</th>
            <th style="padding: 16px 24px; font-weight: 600; background: #e0f2fe; color: #0369a1;">WebhookCatch</th>
          </tr>
        </thead>
        <tbody class="text-body">
          <tr style="border-bottom: 1px solid var(--color-hairline);">
            <td style="padding: 16px 24px; font-weight: 500; color: var(--color-ink);">Setup Time</td>
            <td style="padding: 16px 24px;">Requires Signup</td>
            <td style="padding: 16px 24px; font-weight: 600; background: #f0f9ff; color: #0369a1;">Instant (1-click URL)</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline);">
            <td style="padding: 16px 24px; font-weight: 500; color: var(--color-ink);">Data Retention</td>
            <td style="padding: 16px 24px;">24 Hours</td>
            <td style="padding: 16px 24px; font-weight: 600; background: #f0f9ff; color: #0369a1;">7 Days</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-hairline);">
            <td style="padding: 16px 24px; font-weight: 500; color: var(--color-ink);">Primary Focus</td>
            <td style="padding: 16px 24px;">Forwarding & Workflows</td>
            <td style="padding: 16px 24px; background: #f0f9ff;">Instant Inspection & Debugging</td>
          </tr>
          <tr>
            <td style="padding: 16px 24px; font-weight: 500; color: var(--color-ink);">Cost</td>
            <td style="padding: 16px 24px;">Free tier (Pro is $15/mo)</td>
            <td style="padding: 16px 24px; font-weight: 600; background: #f0f9ff; color: #0369a1;">100% Free</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px; margin-bottom: 64px;">
      <div>
        <h3 class="text-heading-3" style="margin-bottom: 12px; font-weight: 600;">Longer Data Retention</h3>
        <p class="text-body" style="color: var(--color-body);">
          WebhookCatcher's free Hobby plan deletes your data after just 24 hours. If you step away for the weekend, your debug logs are gone. WebhookCatch securely stores your session for a full 7 days completely free.
        </p>
      </div>
      <div>
        <h3 class="text-heading-3" style="margin-bottom: 12px; font-weight: 600;">Zero Friction</h3>
        <p class="text-body" style="color: var(--color-body);">
          If you are building complex n8n workflows or need to forward traffic to multiple targets, WebhookCatcher is a great tool. But if you just need to quickly dump a payload and see what a third-party API is sending you, WebhookCatch skips the signup page entirely.
        </p>
      </div>
    </div>

    <div style="text-align: center; margin-top: 64px; padding: 64px 24px; background: var(--color-canvas); border: 1px solid var(--color-hairline); border-radius: 16px; box-shadow: var(--shadow-level-3);">
      <h3 class="text-display-sm" style="margin-bottom: 16px; font-weight: 700;">Start debugging instantly</h3>
      <p class="text-body" style="color: var(--color-body); margin-bottom: 32px;">Get a free, private URL in one click. No account required.</p>
      <a href="/" class="btn-primary" style="text-decoration: none; display: inline-flex; justify-content: center; font-size: 18px; padding: 16px 32px;">Generate Webhook URL</a>
    </div>
  </main>

  <Footer />
</Layout>
