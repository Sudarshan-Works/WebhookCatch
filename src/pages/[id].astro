---
import Layout from '../layouts/Layout.astro';
import { env } from "cloudflare:workers";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/404');
}

const db = (env as any).DB;
let isValidSession = false;

try {
  const session = await db
    .prepare("SELECT id, expires_at FROM sessions WHERE id = ?")
    .bind(id)
    .first();
  
  if (session) {
    if (Date.now() <= (session.expires_at as number)) {
      isValidSession = true;
    }
  }
} catch (e) {
  // If DB fails (e.g. locally without Wrangler), we might allow it to load and fail on the client
  console.error("Failed to verify session:", e);
}

if (!isValidSession) {
  return Astro.redirect('/404');
}
---

<Layout title={`WebhookCatch — Session ${id}`} description="Inspect incoming webhook requests in real-time." noindex={true}>
  <div class="dashboard" id="dashboard-app" data-session-id={id}>
    <!-- Top Bar -->
    <header class="dash-header">
      <div class="dash-header-left">
        <a href="/" class="dash-brand">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
          </svg>
          <span class="brand-text">WebhookCatch</span>
        </a>
      </div>
      <div class="dash-header-center">
        <div class="url-bar" id="url-bar">
          <code class="url-text text-code" id="webhook-url">Loading…</code>
          <button class="btn-ghost copy-btn" id="copy-url-btn" title="Copy URL">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
          </button>
        </div>
      </div>
      <div class="dash-header-right">
        <div class="session-meta">
          <button class="btn-ghost" id="btn-settings" title="Mock Server Settings" style="padding: 6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </button>
          <span class="badge" id="request-count">0 / 100 requests</span>
          <span class="badge" id="expires-badge" title="Time remaining">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span id="countdown" class="text-caption-mono">—</span>
          </span>
        </div>
      </div>
    </header>

    <div id="limit-banner" style="display: none; background-color: var(--color-warning-soft); color: var(--color-warning); padding: 8px 24px; text-align: center; font-size: 13px; font-weight: 500;">
      Request limit reached (100/100). New requests are being rejected.
    </div>

    <!-- Main Layout -->
    <div class="dash-body">
      <!-- Sidebar: Request List -->
      <aside class="dash-sidebar" id="request-sidebar">
        <div class="sidebar-header">
          <span class="text-caption-mono">Inbox</span>
          <span class="text-caption" style="color: var(--color-mute);" id="total-label">0 requests</span>
        </div>
        <div class="sidebar-filters" style="padding: 12px; border-bottom: 1px solid var(--color-hairline); display: flex; flex-direction: column; gap: 8px;">
          <input type="text" class="input-text text-body-sm" id="search-input" placeholder="Search body, path, headers..." style="width: 100%; border-radius: var(--radius-sm); border: 1px solid var(--color-hairline); background-color: var(--color-canvas); padding: 8px 12px; font-family: var(--font-sans); box-shadow: inset 0 1px 2px rgba(0,0,0,0.02);" />
          <div style="display: flex; gap: 4px;">
            <select class="input-select btn-sm" id="filter-method" style="flex: 1; padding: 4px; font-size: 11px; font-family: var(--font-sans);">
              <option value="">Method</option>
              <option value="GET">GET</option>
              <option value="POST">POST</option>
              <option value="PUT">PUT</option>
              <option value="PATCH">PATCH</option>
            </select>
            <select class="input-select btn-sm" id="filter-status" style="flex: 1; padding: 4px; font-size: 11px; font-family: var(--font-sans);">
              <option value="">Status</option>
              <option value="2">2xx</option>
              <option value="3">3xx</option>
              <option value="4">4xx</option>
              <option value="5">5xx</option>
            </select>
            <select class="input-select btn-sm" id="filter-provider" style="flex: 1; padding: 4px; font-size: 11px; font-family: var(--font-sans);">
              <option value="">Provider</option>
              <option value="Stripe">Stripe</option>
              <option value="GitHub">GitHub</option>
              <option value="Shopify">Shopify</option>
              <option value="Slack">Slack</option>
              <option value="Discord">Discord</option>
              <option value="PayPal">PayPal</option>
            </select>
          </div>
        </div>
        <div class="sidebar-list" id="request-list">
          <div class="empty-state" id="empty-state">
            <div class="pulse-indicator">
              <div class="pulse-ring"></div>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-ink); position: relative; z-index: 2;">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
            </div>
            <p class="text-body-sm-strong" style="color: var(--color-ink); margin: 16px 0 4px;">Listening for events...</p>
            <p class="text-caption" style="color: var(--color-mute); margin: 0 0 24px; line-height: 1.4;">Send a request to your webhook URL.</p>
            
            <div class="skeleton-list">
              <div class="skeleton-item"></div>
              <div class="skeleton-item"></div>
              <div class="skeleton-item"></div>
            </div>
          </div>
        </div>
      </aside>

      <!-- Main: Request Detail -->
      <main class="dash-main" id="request-detail">
        <div class="detail-empty" id="detail-empty">
          <div class="detail-empty-card">
            <div class="detail-empty-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <path d="M3 9h18"/>
                <path d="M9 21V9"/>
              </svg>
            </div>
            <h3 class="text-display-sm" style="margin: 0 0 8px;">No request selected</h3>
            <p class="text-body-sm" style="color: var(--color-body); margin: 0;">
              Select a request from the sidebar to inspect its method, headers, and payload.
            </p>
          </div>
        </div>

        <div class="detail-content" id="detail-content" style="display: none;">
          <!-- Request Meta Grid -->
          <div class="detail-summary" id="detail-summary">
            <div class="detail-summary-left">
              <button class="btn-ghost mobile-back-btn" id="btn-mobile-back" aria-label="Back to requests" style="display: none; padding: 6px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
              </button>
              <h2 class="text-display-xs" style="margin: 0;">Request Details</h2>
            </div>
          </div>
          <div class="detail-meta-grid">
            <div class="meta-item">
              <span class="meta-label">Method</span>
              <span class="badge-method" id="detail-method">GET</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Status</span>
              <span class="meta-value text-code" style="color: var(--color-success);">200 OK</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Path</span>
              <span class="meta-value text-code" id="detail-path">/</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Timestamp</span>
              <span class="meta-value" id="detail-time">—</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Content Type</span>
              <span class="meta-value text-code" id="detail-content-type">—</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Size</span>
              <span class="meta-value" id="detail-size">0 B</span>
            </div>
          </div>
          
          <div class="detail-actions" style="padding: 16px 32px; border-bottom: 1px solid var(--color-hairline); display: flex; gap: 8px; background-color: var(--color-canvas);">
            <button class="btn-primary btn-sm" id="btn-edit-replay">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px; vertical-align:text-bottom;"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
              Edit & Replay
            </button>
            <button class="btn-ghost btn-sm" id="btn-replay">Replay</button>
          </div>

          <!-- Tabs -->
          <div class="detail-tabs-container">
            <div class="detail-tabs">
              <button class="tab-btn active" data-tab="panel-body">Body</button>
              <button class="tab-btn" data-tab="panel-headers">Headers</button>
              <button class="tab-btn" data-tab="panel-query">Query Params</button>
              <button class="tab-btn" data-tab="panel-raw">Raw</button>
              <button class="tab-btn" data-tab="panel-diagnostics">Diagnostics</button>
            </div>
          </div>

          <!-- Tab Panels -->
          <div class="tab-panel active" id="panel-body">
            <div class="panel-content">
              <div id="body-empty" class="panel-empty" style="display: none;">
                <p class="text-body-sm" style="color: var(--color-mute);">No body payload found in this request.</p>
              </div>
              <div class="code-editor-mockup" id="body-container" style="display: none;">
                <div class="code-editor-header" style="justify-content: space-between;">
                  <div style="display: flex; gap: 8px; align-items: center;">
                    <span class="code-editor-dot" style="background-color: #ff5f56;"></span>
                    <span class="code-editor-dot" style="background-color: #ffbd2e;"></span>
                    <span class="code-editor-dot" style="background-color: #27c93f;"></span>
                  </div>
                  <div class="code-actions" style="display: flex; gap: 8px;">
                    <button class="btn-ghost btn-sm" id="btn-copy-json">Copy JSON</button>
                    <button class="btn-ghost btn-sm" id="btn-copy-curl">Copy as cURL</button>
                  </div>
                </div>
                <pre style="margin: 0;"><code class="code-content text-code language-json" id="body-content" style="padding: 24px; display: block; overflow-x: auto;"></code></pre>
              </div>
            </div>
          </div>

          <div class="tab-panel" id="panel-headers" style="display: none;">
            <div class="panel-content">
              <table class="kv-table" id="headers-table">
                <thead>
                  <tr>
                    <th class="text-caption-mono">Header</th>
                    <th class="text-caption-mono">Value</th>
                  </tr>
                </thead>
                <tbody id="headers-tbody"></tbody>
              </table>
            </div>
          </div>

          <div class="tab-panel" id="panel-query" style="display: none;">
            <div class="panel-content">
              <table class="kv-table" id="query-table">
                <thead>
                  <tr>
                    <th class="text-caption-mono">Parameter</th>
                    <th class="text-caption-mono">Value</th>
                  </tr>
                </thead>
                <tbody id="query-tbody"></tbody>
              </table>
              <div id="query-empty" class="panel-empty" style="display: none;">
                <p class="text-body-sm" style="color: var(--color-mute);">No query parameters found in this request.</p>
              </div>
            </div>
          </div>

          <div class="tab-panel" id="panel-raw" style="display: none;">
            <div class="panel-content">
              <div class="code-editor-mockup">
                <div class="code-editor-header">
                  <span class="code-editor-dot" style="background-color: #ff5f56;"></span>
                  <span class="code-editor-dot" style="background-color: #ffbd2e;"></span>
                  <span class="code-editor-dot" style="background-color: #27c93f;"></span>
                </div>
                <pre class="code-content text-code" id="raw-content" style="margin:0;"></pre>
              </div>
            </div>
          </div>

          <div class="tab-panel" id="panel-diagnostics" style="display: none;">
            <div class="panel-content" style="display: flex; flex-direction: column; gap: 32px;">
              <div>
                <h3 class="text-body-md" style="font-weight: 600; margin-bottom: 12px;">Provider Detection</h3>
                <div id="diag-provider" class="meta-value" style="display:flex; align-items:center; gap:8px;">
                  <span class="badge" style="background-color: var(--color-canvas-soft); color: var(--color-mute);">Analyzing...</span>
                </div>
              </div>

              <div>
                <h3 class="text-body-md" style="font-weight: 600; margin-bottom: 12px;">Checks Passed</h3>
                <ul id="diag-checks" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
                </ul>
              </div>

              <div>
                <h3 class="text-body-md" style="font-weight: 600; margin-bottom: 12px;">Warnings</h3>
                <ul id="diag-warnings" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
                </ul>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Replay Modal -->
  <div id="replay-modal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="text-body-md" style="font-weight: 600;">Edit & Replay</h3>
        <button class="btn-ghost btn-sm" id="btn-close-modal" style="padding: 4px;">✕</button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label class="meta-label">Destination URL</label>
          <div style="display: flex; gap: 8px;">
            <select class="input-select text-code" id="replay-method">
              <option>GET</option>
              <option>POST</option>
              <option>PUT</option>
              <option>PATCH</option>
              <option>DELETE</option>
            </select>
            <input type="text" class="input-text text-code" id="replay-url" placeholder="https://your-server.com/webhook" style="flex: 1;" />
          </div>
        </div>
        <div class="form-group">
          <label class="meta-label">Headers (JSON format)</label>
          <textarea class="input-textarea text-code" id="replay-headers" rows="2" style="font-size:12px;"></textarea>
        </div>
        <div class="form-group">
          <label class="meta-label">Query Params (JSON format)</label>
          <textarea class="input-textarea text-code" id="replay-query" rows="2" style="font-size:12px;"></textarea>
        </div>
        <div class="form-group">
          <label class="meta-label">Body</label>
          <textarea class="input-textarea text-code" id="replay-body" rows="4" style="font-size:12px;"></textarea>
        </div>
      </div>
      
      <div class="modal-response" id="replay-response-section" style="display: none;">
        <div style="display: flex; gap: 16px; margin-bottom: 8px; align-items: center; padding: 0 24px;">
          <span class="meta-label">Response</span>
          <span class="badge" id="replay-res-status"></span>
          <span class="text-caption-mono" id="replay-res-time" style="color:var(--color-mute);"></span>
        </div>
        <div style="padding: 0 24px 24px;">
          <pre class="code-editor-mockup"><code class="code-content text-code" id="replay-res-body" style="padding: 16px; display: block; max-height: 200px; overflow-y: auto;"></code></pre>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn-primary" id="btn-send-replay" style="width: 100%;">Send Request</button>
      </div>
    </div>
  </div>

  <!-- Settings Modal -->
  <div id="settings-modal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="text-body-md" style="font-weight: 600;">Mock Server Settings</h3>
        <button class="btn-ghost btn-sm" id="btn-close-settings" style="padding: 4px;">✕</button>
      </div>
      <div class="modal-body">
        <p class="text-body-sm" style="color: var(--color-mute);">Configure how this webhook endpoint responds to incoming requests.</p>
        
        <div class="form-group">
          <label class="meta-label">HTTP Status Code</label>
          <input type="number" class="input-text text-code" id="setting-status" placeholder="200" min="100" max="599" />
        </div>
        
        <div class="form-group">
          <label class="meta-label">Response Delay (ms)</label>
          <input type="number" class="input-text text-code" id="setting-delay" placeholder="0" min="0" max="30000" />
        </div>

        <div class="form-group">
          <label class="meta-label">Custom Headers (JSON)</label>
          <textarea class="input-textarea text-code" id="setting-headers" rows="3" placeholder='{"X-Custom-Header": "value"}'></textarea>
        </div>

        <div class="form-group">
          <label class="meta-label">Response Body</label>
          <textarea class="input-textarea text-code" id="setting-body" rows="4" placeholder='{"ok": true}'></textarea>
        </div>
      </div>
      
      <div class="modal-footer" style="display: flex; justify-content: space-between; align-items: center;">
        <span id="settings-save-msg" class="text-body-sm" style="color: var(--color-success); display: none;">Saved successfully!</span>
        <button class="btn-primary" id="btn-save-settings" style="margin-left: auto;">Save Settings</button>
      </div>
    </div>
  </div>

  <!-- Expired Overlay -->
  <div id="expired-overlay" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--color-canvas); z-index: 10000; align-items: center; justify-content: center; flex-direction: column;">
    <div style="background-color: var(--color-canvas-soft); padding: 48px; border-radius: var(--radius-lg); text-align: center; border: 1px solid var(--color-hairline); max-width: 400px; box-shadow: var(--shadow-level-3);">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--color-error)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto 24px;">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <h2 class="text-display-md" style="margin-bottom: 8px;">Session Expired</h2>
      <p class="text-body-md" style="color: var(--color-body); margin-bottom: 24px;">This temporary webhook session has expired and all associated data has been deleted.</p>
      <a href="/" class="btn-primary" style="text-decoration: none;">Create New URL</a>
    </div>
  </div>
</Layout>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/json.min.js"></script>
<script>
  const app = document.getElementById('dashboard-app')!;
  const sessionId = app.dataset.sessionId!;
  const webhookUrlEl = document.getElementById('webhook-url')!;
  const copyBtn = document.getElementById('copy-url-btn')!;
  const countEl = document.getElementById('request-count')!;
  const countdownEl = document.getElementById('countdown')!;
  const totalLabel = document.getElementById('total-label')!;
  const requestList = document.getElementById('request-list')!;
  const emptyState = document.getElementById('empty-state')!;
  const detailEmpty = document.getElementById('detail-empty')!;
  const detailContent = document.getElementById('detail-content')!;
  const detailMethod = document.getElementById('detail-method')!;
  const detailPath = document.getElementById('detail-path')!;
  const detailTime = document.getElementById('detail-time')!;
  const detailContentType = document.getElementById('detail-content-type')!;
  const detailSize = document.getElementById('detail-size')!;
  const headersTbody = document.getElementById('headers-tbody')!;
  const rawContent = document.getElementById('raw-content')!;
  const btnCopyUrl = document.getElementById('copy-url-btn') as HTMLButtonElement;
  const btnCopyJson = document.getElementById('btn-copy-json') as HTMLButtonElement;
  const btnCopyCurl = document.getElementById('btn-copy-curl') as HTMLButtonElement;
  const btnReplay = document.getElementById('btn-replay') as HTMLButtonElement;
  const btnEditReplay = document.getElementById('btn-edit-replay') as HTMLButtonElement;
  const queryTbody = document.getElementById('query-tbody')!;
  const queryEmpty = document.getElementById('query-empty')!;
  const queryTable = document.getElementById('query-table')!;
  const bodyContainer = document.getElementById('body-container')!;
  const bodyContent = document.getElementById('body-content')!;
  const bodyEmpty = document.getElementById('body-empty')!;

  const btnSettings = document.getElementById('btn-settings') as HTMLButtonElement;
  const settingsModal = document.getElementById('settings-modal')!;
  const btnCloseSettings = document.getElementById('btn-close-settings') as HTMLButtonElement;
  const btnSaveSettings = document.getElementById('btn-save-settings') as HTMLButtonElement;
  const settingStatus = document.getElementById('setting-status') as HTMLInputElement;
  const settingDelay = document.getElementById('setting-delay') as HTMLInputElement;
  const settingHeaders = document.getElementById('setting-headers') as HTMLTextAreaElement;
  const settingBody = document.getElementById('setting-body') as HTMLTextAreaElement;
  const settingsSaveMsg = document.getElementById('settings-save-msg')!;

  const limitBanner = document.getElementById('limit-banner')!;
  const expiredOverlay = document.getElementById('expired-overlay')!;
  const expiresBadge = document.getElementById('expires-badge')!;

  btnSettings.onclick = () => settingsModal.style.display = 'flex';
  btnCloseSettings.onclick = () => settingsModal.style.display = 'none';

  btnSaveSettings.onclick = async () => {
    btnSaveSettings.textContent = 'Saving...';
    btnSaveSettings.disabled = true;
    try {
      let headersObj = null;
      if (settingHeaders.value) {
        headersObj = JSON.parse(settingHeaders.value);
      }

      await fetch(`/api/sessions/${sessionId}/settings`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          custom_status: settingStatus.value ? parseInt(settingStatus.value) : null,
          custom_delay: settingDelay.value ? parseInt(settingDelay.value) : null,
          custom_headers: headersObj,
          custom_body: settingBody.value || null
        })
      });

      settingsSaveMsg.style.display = 'inline-block';
      setTimeout(() => settingsSaveMsg.style.display = 'none', 3000);
    } catch (e) {
      alert('Failed to save settings. Check your JSON format for headers.');
    } finally {
      btnSaveSettings.textContent = 'Save Settings';
      btnSaveSettings.disabled = false;
    }
  };

  // Build webhook URL
  const baseUrl = window.location.origin;
  const webhookUrl = `${baseUrl}/w/${sessionId}`;
  webhookUrlEl.textContent = webhookUrl;

  // Copy URL
  copyBtn.addEventListener('click', async () => {
    await navigator.clipboard.writeText(webhookUrl);
    // @ts-ignore
    if (window.showToast) window.showToast('Copied URL to clipboard');
  });

  // Mobile Back Button
  const btnMobileBack = document.getElementById('btn-mobile-back') as HTMLButtonElement;
  const dashboardApp = document.getElementById('dashboard-app') as HTMLElement;
  btnMobileBack.addEventListener('click', () => {
    dashboardApp.classList.remove('is-viewing-detail');
  });

  // Tabs
  document.querySelectorAll('.tab-btn').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => {
        (p as HTMLElement).style.display = 'none';
        p.classList.remove('active');
      });
      tab.classList.add('active');
      const panelId = (tab as HTMLElement).dataset.tab!;
      const panel = document.getElementById(panelId)!;
      panel.style.display = 'block';
      setTimeout(() => panel.classList.add('active'), 10);
    });
  });

  // State
  let requests: any[] = [];
  let filteredRequests: any[] = [];
  let selectedId: number | null = null;
  let expiresAt: number | null = null;

  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const filterMethod = document.getElementById('filter-method') as unknown as HTMLSelectElement;
  const filterStatus = document.getElementById('filter-status') as unknown as HTMLSelectElement;
  const filterProvider = document.getElementById('filter-provider') as unknown as HTMLSelectElement;

  function applyFilters() {
    const q = (searchInput?.value || '').toLowerCase();
    const fMethod = filterMethod?.value || '';
    const fStatus = filterStatus?.value || '';
    const fProv = filterProvider?.value || '';

    filteredRequests = requests.filter(req => {
      // Method filter
      if (fMethod && req.method !== fMethod) return false;
      
      // Status filter
      if (fStatus) {
        if (!req.status) return false;
        const sString = String(req.status);
        if (!sString.startsWith(fStatus)) return false;
      }
      
      // Provider filter
      const { providerName, eventName } = detectProviderInfo(req);
      if (fProv && providerName !== fProv) return false;
      
      // Text search
      if (q) {
        let match = false;
        if (req.method.toLowerCase().includes(q)) match = true;
        if (req.path && req.path.toLowerCase().includes(q)) match = true;
        if (providerName.toLowerCase().includes(q)) match = true;
        if (eventName.toLowerCase().includes(q)) match = true;
        if (!match && req.body && String(req.body).toLowerCase().includes(q)) match = true;
        if (!match && req.headers && JSON.stringify(req.headers).toLowerCase().includes(q)) match = true;
        if (!match) return false;
      }
      return true;
    });

    renderList();
  }

  searchInput?.addEventListener('input', applyFilters);
  filterMethod?.addEventListener('change', applyFilters);
  filterStatus?.addEventListener('change', applyFilters);
  filterProvider?.addEventListener('change', applyFilters);

  // Countdown timer
  function updateCountdown() {
    if (!expiresAt) return;
    const remaining = expiresAt - Date.now();
    if (remaining <= 0) {
      countdownEl.textContent = '00:00:00';
      expiresBadge.style.color = 'var(--color-error)';
      return;
    }
    
    // Approaching expiration (less than 5 minutes)
    if (remaining < 5 * 60 * 1000) {
      expiresBadge.style.color = 'var(--color-warning)';
    } else {
      expiresBadge.style.color = '';
    }

    const days = Math.floor(remaining / (1000 * 60 * 60 * 24));
    const hours = Math.floor((remaining % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((remaining % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((remaining % (1000 * 60)) / 1000);
    
    if (days > 0) {
      countdownEl.textContent = `${days}d ${hours}h`;
    } else {
      countdownEl.textContent = `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
    }
  }
  setInterval(updateCountdown, 1000);

  // Replay Logic
  const replayModal = document.getElementById('replay-modal')!;
  const btnCloseModal = document.getElementById('btn-close-modal') as HTMLButtonElement;
  const btnSendReplay = document.getElementById('btn-send-replay') as HTMLButtonElement;
  const replayMethod = document.getElementById('replay-method') as unknown as HTMLSelectElement;
  const replayUrl = document.getElementById('replay-url') as HTMLInputElement;
  const replayHeaders = document.getElementById('replay-headers') as HTMLTextAreaElement;
  const replayQuery = document.getElementById('replay-query') as HTMLTextAreaElement;
  const replayBody = document.getElementById('replay-body') as HTMLTextAreaElement;
  const replayResSection = document.getElementById('replay-response-section')!;
  const replayResStatus = document.getElementById('replay-res-status')!;
  const replayResTime = document.getElementById('replay-res-time')!;
  const replayResBody = document.getElementById('replay-res-body')!;

  let lastReplayUrl = '';

  function openReplayModal(autoSend = false) {
    const req = requests.find(r => r.id === selectedId);
    if (!req) return;

    replayMethod.value = req.method;
    replayUrl.value = lastReplayUrl || `${baseUrl}${req.path || '/w/' + sessionId}`;
    replayHeaders.value = JSON.stringify(req.headers || {}, null, 2);
    replayQuery.value = JSON.stringify(req.query || {}, null, 2);
    replayBody.value = req.body || '';
    
    replayResSection.style.display = 'none';
    replayModal.style.display = 'flex';
    
    if (autoSend) {
      executeReplay();
    }
  }

  btnCloseModal.onclick = () => replayModal.style.display = 'none';
  btnEditReplay.onclick = () => openReplayModal(false);
  btnReplay.onclick = () => openReplayModal(true);
  
  async function executeReplay() {
    lastReplayUrl = replayUrl.value;
    btnSendReplay.textContent = 'Sending...';
    btnSendReplay.disabled = true;
    replayResSection.style.display = 'none';

    try {
      const payload = {
        url: replayUrl.value,
        method: replayMethod.value,
        headers: JSON.parse(replayHeaders.value || '{}'),
        query: JSON.parse(replayQuery.value || '{}'),
        body: replayBody.value
      };

      const res = await fetch(`/api/sessions/${sessionId}/replay`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json() as any;

      replayResSection.style.display = 'block';
      if (data.error) {
        replayResStatus.textContent = 'Error';
        replayResStatus.className = 'badge badge-method-delete';
        replayResBody.textContent = data.error;
        replayResTime.textContent = data.timeMs ? `${data.timeMs}ms` : '';
      } else {
        replayResStatus.textContent = `${data.status} ${data.statusText}`;
        replayResStatus.className = data.success ? 'badge badge-method-get' : 'badge badge-method-delete';
        replayResTime.textContent = `${data.timeMs}ms`;
        replayResBody.textContent = data.body || '[Empty]';
      }
    } catch (err: any) {
      replayResSection.style.display = 'block';
      replayResStatus.textContent = 'Network Error';
      replayResStatus.className = 'badge badge-method-delete';
      replayResBody.textContent = err.message || String(err);
    } finally {
      btnSendReplay.textContent = 'Send Request';
      btnSendReplay.disabled = false;
    }
  }

  btnSendReplay.onclick = executeReplay;

  function detectProviderInfo(req: any) {
    const headersLow: Record<string, string> = {};
    if (req.headers) {
      for (const [k, v] of Object.entries(req.headers)) {
        headersLow[k.toLowerCase()] = String(v);
      }
    }
    const ua = (headersLow['user-agent'] || '').toLowerCase();
    
    let providerName = 'Unknown';
    let eventName = '';
    let confidence = false;

    // Stripe
    if (headersLow['stripe-signature']) {
      providerName = 'Stripe'; confidence = true; eventName = 'event';
    } else if (ua.includes('stripe')) {
      providerName = 'Stripe';
    }
    // GitHub
    if (headersLow['x-github-event'] || headersLow['x-github-delivery']) {
      providerName = 'GitHub'; confidence = true;
      eventName = headersLow['x-github-event'] || '';
    } else if (ua.includes('github-hooks')) {
      providerName = 'GitHub';
    }
    // Shopify
    if (headersLow['x-shopify-topic']) {
      providerName = 'Shopify'; confidence = true;
      eventName = headersLow['x-shopify-topic'] || '';
    }
    // Slack
    if (headersLow['x-slack-signature'] || headersLow['x-slack-request-timestamp']) {
      providerName = 'Slack'; confidence = true;
    }
    // Discord
    if (headersLow['x-signature-ed25519'] || headersLow['x-signature-timestamp']) {
      providerName = 'Discord'; confidence = true;
    }
    // PayPal
    if (headersLow['paypal-auth-algo'] || headersLow['paypal-cert-url'] || headersLow['paypal-transmission-id']) {
      providerName = 'PayPal'; confidence = true;
    }

    return { providerName, confidence, eventName, headersLow };
  }

  // Diagnostics Logic
  const diagProvider = document.getElementById('diag-provider')!;
  const diagChecks = document.getElementById('diag-checks')!;
  const diagWarnings = document.getElementById('diag-warnings')!;

  function runDiagnostics(req: any) {
    diagChecks.innerHTML = '';
    diagWarnings.innerHTML = '';
    diagProvider.innerHTML = '';

    const checks: string[] = [];
    const warnings: string[] = [];
    
    const { providerName, confidence, headersLow } = detectProviderInfo(req);

    if (req.method === 'POST') checks.push('POST request');
    else warnings.push(`Not a POST request (${escapeHtml(req.method)})`);

    const contentType = req.headers && (req.headers['content-type'] || req.headers['Content-Type']);
    if (contentType) checks.push(`Content-Type detected: ${escapeHtml(String(contentType))}`);
    else warnings.push('No Content-Type header');

    if (req.body) {
      try {
        JSON.parse(req.body);
        checks.push('Valid JSON payload');
      } catch (e) {
        if (contentType && String(contentType).toLowerCase().includes('json')) {
          warnings.push('Invalid JSON payload despite application/json header');
        }
      }
    }

    if (req.size !== undefined) {
      checks.push(`Payload size: ${formatSize(req.size)}`);
    }

    if (req.status && req.status >= 400) {
      warnings.push(`HTTP ${req.status} Error`);
    }

    // Provider warnings
    if (providerName === 'Stripe' && !headersLow['stripe-signature']) warnings.push('Missing expected signature header (stripe-signature)');
    if (providerName === 'GitHub' && !headersLow['x-hub-signature-256'] && !headersLow['x-hub-signature']) warnings.push('Missing expected signature header (x-hub-signature-256)');
    if (providerName === 'Shopify' && !headersLow['x-shopify-hmac-sha256']) warnings.push('Missing expected signature header (x-shopify-hmac-sha256)');
    if (providerName === 'Slack' && !headersLow['x-slack-signature']) warnings.push('Missing expected signature header (x-slack-signature)');
    if (providerName === 'Discord' && !headersLow['x-signature-ed25519']) warnings.push('Missing expected signature header (x-signature-ed25519)');
    if (providerName === 'PayPal' && !headersLow['paypal-transmission-id']) warnings.push('Missing expected signature header (paypal-transmission-id)');

    // Duplicate Check
    const dupKeys = ['x-github-delivery', 'stripe-signature', 'paypal-transmission-id', 'x-slack-signature'];
    for (const key of dupKeys) {
      if (headersLow[key]) {
        const val = headersLow[key];
        const count = requests.filter(r => {
          const rHeaders: Record<string, string> = {};
          if (r.headers) Object.entries(r.headers).forEach(([k,v]) => rHeaders[k.toLowerCase()] = String(v));
          return rHeaders[key] === val;
        }).length;
        if (count > 1) {
          warnings.push('Possible duplicate event (matching idempotency key)');
          break;
        }
      }
    }

    if (confidence) {
      diagProvider.innerHTML = `<span class="badge" style="background-color: var(--color-ink); color: var(--color-canvas); font-weight:600;">${escapeHtml(providerName)}</span>`;
    } else {
      diagProvider.innerHTML = `<span class="badge" style="background-color: var(--color-canvas-soft); color: var(--color-mute);">Unknown Provider</span>`;
    }

    if (checks.length === 0) {
      diagChecks.innerHTML = '<li class="text-caption" style="color:var(--color-mute);">No basic checks passed.</li>';
    } else {
      checks.forEach(c => {
        const li = document.createElement('li');
        li.style.display = 'flex'; li.style.alignItems = 'center'; li.style.gap = '8px';
        li.innerHTML = `<span style="color: #27c93f; font-weight:bold;">✓</span> <span class="meta-value">${c}</span>`;
        diagChecks.appendChild(li);
      });
    }

    if (warnings.length === 0) {
      diagWarnings.innerHTML = '<li class="text-caption" style="color:var(--color-mute);">No warnings detected.</li>';
    } else {
      warnings.forEach(w => {
        const li = document.createElement('li');
        li.style.display = 'flex'; li.style.alignItems = 'center'; li.style.gap = '8px';
        li.innerHTML = `<span style="color: #ffbd2e; font-weight:bold;">⚠</span> <span class="meta-value">${w}</span>`;
        diagWarnings.appendChild(li);
      });
    }
  }

  function formatSize(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`;
    return `${(bytes/1024).toFixed(2)} KB`;
  }

  // Method color class
  function methodClass(method: string): string {
    return `badge-method badge-method-${method.toLowerCase()}`;
  }

  // Format time relative or absolute
  function formatTimeShort(ts: number): string {
    const d = new Date(ts);
    return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  }

  // Render request list
  function renderList() {
    totalLabel.textContent = `${filteredRequests.length} request${filteredRequests.length !== 1 ? 's' : ''}`;

    if (filteredRequests.length === 0) {
      emptyState.style.display = 'flex';
      const existing = requestList.querySelectorAll('.request-item');
      existing.forEach(el => el.remove());
      if (requests.length > 0) {
        emptyState.innerHTML = '<p class="text-body-sm" style="color: var(--color-mute); margin: 8px 0 4px;">No matching requests</p>';
      } else {
        emptyState.innerHTML = '<div class="pulse-indicator"><span class="pulse-dot"></span></div><p class="text-body-sm-strong" style="color: var(--color-ink); margin: 8px 0 4px;">Waiting for first request</p><p class="text-caption" style="color: var(--color-mute);">Send a request to your webhook URL</p>';
      }
      return;
    }
    emptyState.style.display = 'none';

    // Clear existing items (but keep empty-state div)
    const existing = requestList.querySelectorAll('.request-item');
    existing.forEach(el => el.remove());

    filteredRequests.forEach((req, index) => {
      const item = document.createElement('button');
      item.className = `request-item ${req.id === selectedId ? 'selected' : ''}`;
      item.dataset.requestId = String(req.id);
      
      item.innerHTML = `
        <div class="request-item-indicator"></div>
        <div class="request-item-content">
          <div class="request-item-top">
            <span class="${escapeHtml(methodClass(req.method))}">${escapeHtml(req.method)}</span>
            <span class="request-item-time text-caption">${formatTimeShort(req.created_at)}</span>
          </div>
          <div class="request-item-bottom" style="margin-top: 8px;">
            <span class="text-code" style="font-size: 11px; color: var(--color-body); display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%;">${escapeHtml(req.path || '/')}</span>
          </div>
        </div>
      `;
      if (index === 0 && filteredRequests.length > (existing?.length ?? 0)) {
        item.style.animation = 'slideInRight 0.3s cubic-bezier(0.16, 1, 0.3, 1)';
      }
      item.addEventListener('click', () => selectRequest(req));
      requestList.appendChild(item);
    });
  }

  // Select a request
  function selectRequest(req: any) {
    selectedId = req.id;
    detailEmpty.style.display = 'none';
    detailContent.style.display = 'flex';
    dashboardApp.classList.add('is-viewing-detail');

    // Method & Path
    detailMethod.className = methodClass(req.method);
    detailMethod.textContent = req.method;
    detailPath.textContent = req.path || '/';

    // Time
    const d = new Date(req.created_at);
    detailTime.textContent = d.toLocaleString(undefined, {
      month: 'short', day: 'numeric', year: 'numeric',
      hour: '2-digit', minute: '2-digit', second: '2-digit', fractionalSecondDigits: 3
    });

    // Headers
    headersTbody.innerHTML = '';
    const headers = req.headers || {};
    Object.entries(headers).forEach(([key, value]) => {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td class="text-code">${escapeHtml(key)}</td><td class="text-code">${escapeHtml(value as string)}</td>`;
      headersTbody.appendChild(tr);
    });

    // Content Type & Size
    const contentType = Object.keys(headers).find(k => k.toLowerCase() === 'content-type');
    detailContentType.textContent = contentType ? headers[contentType] : 'None';
    
    const bodySize = req.body ? new Blob([req.body]).size : 0;
    detailSize.textContent = bodySize < 1024 ? `${bodySize} B` : `${(bodySize/1024).toFixed(2)} KB`;

    // Query
    const query = req.query || {};
    const queryKeys = Object.keys(query);
    if (queryKeys.length === 0) {
      queryTable.style.display = 'none';
      queryEmpty.style.display = 'flex';
    } else {
      queryTable.style.display = 'table';
      queryEmpty.style.display = 'none';
      queryTbody.innerHTML = '';
      queryKeys.forEach(key => {
        const tr = document.createElement('tr');
        tr.innerHTML = `<td class="text-code">${escapeHtml(key)}</td><td class="text-code">${escapeHtml(query[key])}</td>`;
        queryTbody.appendChild(tr);
      });
    }

    // Body
    const body = req.body || '';
    if (!body) {
      bodyContainer.style.display = 'none';
      bodyEmpty.style.display = 'flex';
      btnCopyJson.style.display = 'none';
    } else {
      bodyEmpty.style.display = 'none';
      bodyContainer.style.display = 'block';
      // Try to pretty-print JSON
      let formattedJson = body;
      let isJson = false;
      try {
        const parsed = JSON.parse(body);
        formattedJson = JSON.stringify(parsed, null, 2);
        isJson = true;
      } catch {}
      
      bodyContent.textContent = formattedJson;
      // @ts-ignore
      if (window.hljs && isJson) {
        // @ts-ignore
        bodyContent.dataset.highlighted = ''; // reset highlight.js flag
        // @ts-ignore
        hljs.highlightElement(bodyContent);
      }
      
      btnCopyJson.style.display = isJson ? 'inline-flex' : 'none';
      btnCopyJson.onclick = () => {
        navigator.clipboard.writeText(formattedJson);
        // @ts-ignore
        if (window.showToast) window.showToast('Copied JSON payload');
      };
    }
    
    // Copy as cURL
    btnCopyCurl.onclick = () => {
      let curl = `curl -X ${req.method} "${baseUrl}${req.path || '/w/' + sessionId}"`;
      for (const [key, val] of Object.entries(headers)) {
        curl += ` \\\n  -H "${key}: ${val}"`;
      }
      if (body) {
        const escapedBody = body.replace(/"/g, '\\"');
        curl += ` \\\n  -d "${escapedBody}"`;
      }
      navigator.clipboard.writeText(curl);
      // @ts-ignore
      if (window.showToast) window.showToast('Copied cURL command');
    };

    // Raw
    let rawStr = `${req.method} ${req.path || '/'} HTTP/1.1\r\n`;
    for (const [key, val] of Object.entries(headers)) {
      rawStr += `${key}: ${val}\r\n`;
    }
    rawStr += `\r\n`;
    rawStr += body;
    rawContent.textContent = rawStr;
    
    runDiagnostics(req);

    // Update selection highlight
    requestList.querySelectorAll('.request-item').forEach(el => {
      el.classList.toggle('selected', (el as HTMLElement).dataset.requestId === String(req.id));
    });
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  // Listen for real-time updates via SSE
  let eventSource: EventSource | null = null;

  function connectStream() {
    if (eventSource) {
      eventSource.close();
    }
    
    eventSource = new EventSource(`/api/sessions/${sessionId}/stream`);
    
    eventSource.onmessage = (event) => {
      try {
        const data = JSON.parse(event.data);
        
        expiresAt = data.session.expires_at;
        updateCountdown();

        if (data.session.request_count >= 100) {
          limitBanner.style.display = 'block';
        }

        // Initialize settings fields on first load if they exist
        if (data.session.custom_status && !settingStatus.value) settingStatus.value = data.session.custom_status;
        if (data.session.custom_delay && !settingDelay.value) settingDelay.value = data.session.custom_delay;
        if (data.session.custom_headers && !settingHeaders.value) settingHeaders.value = JSON.stringify(data.session.custom_headers, null, 2);
        if (data.session.custom_body && !settingBody.value) settingBody.value = data.session.custom_body;

        countEl.textContent = `${data.session.request_count} / 100 requests`;

        requests = data.requests;
        applyFilters();

        // Auto-select first request if none selected and new requests arrived
        if (selectedId === null && filteredRequests.length > 0) {
          selectRequest(filteredRequests[0]);
        } else if (selectedId !== null) {
          // Re-render detail if selected request might have changed
          const selected = requests.find((r: any) => r.id === selectedId);
          if (selected) selectRequest(selected);
        }
      } catch (err) {
        console.error('Error parsing stream data:', err);
      }
    };
    
    eventSource.addEventListener('error', (event: any) => {
      if (event.data && event.data.includes('expired')) {
        eventSource?.close();
        expiredOverlay.style.display = 'flex';
      } else if (event.data) {
        console.warn('Stream error:', event.data);
        eventSource?.close();
      }
      // Note: EventSource automatically handles normal network reconnects
    });
  }

  connectStream();

  // Keyboard Shortcuts
  document.addEventListener('keydown', (e) => {
    // Ignore if typing in an input or textarea
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement || e.target instanceof HTMLSelectElement) {
      if (e.key === 'Escape') {
        (e.target as HTMLElement).blur();
      }
      return;
    }

    if (e.key === 'c') {
      btnCopyUrl.click();
    } else if (e.key === '/') {
      e.preventDefault();
      searchInput.focus();
    } else if (e.key === 'j' || e.key === 'ArrowDown') {
      e.preventDefault();
      if (filteredRequests.length > 0) {
        const currentIndex = filteredRequests.findIndex(r => r.id === selectedId);
        const nextIndex = currentIndex < filteredRequests.length - 1 ? currentIndex + 1 : 0;
        selectRequest(filteredRequests[nextIndex]);
        // scroll sidebar to next element
        const el = requestList.querySelector(`[data-request-id="${filteredRequests[nextIndex].id}"]`);
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    } else if (e.key === 'k' || e.key === 'ArrowUp') {
      e.preventDefault();
      if (filteredRequests.length > 0) {
        const currentIndex = filteredRequests.findIndex(r => r.id === selectedId);
        const prevIndex = currentIndex > 0 ? currentIndex - 1 : filteredRequests.length - 1;
        selectRequest(filteredRequests[prevIndex]);
        // scroll sidebar to prev element
        const el = requestList.querySelector(`[data-request-id="${filteredRequests[prevIndex].id}"]`);
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    } else if (e.key === 'r' && selectedId !== null) {
      document.getElementById('btn-replay')?.click();
    } else if (e.key === 'Escape') {
      if (settingsModal.style.display === 'flex') {
        settingsModal.style.display = 'none';
      }
      if (replayModal.style.display === 'flex') {
        replayModal.style.display = 'none';
      }
    }
  });
</script>

