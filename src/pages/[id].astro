---
import Layout from '../layouts/Layout.astro';

const { id } = Astro.params;
---

<Layout title={`WebhookCatch — Session ${id}`} description="Inspect incoming webhook requests in real-time.">
  <div class="dashboard" id="dashboard-app" data-session-id={id}>
    <!-- Top Bar -->
    <header class="dash-header">
      <div class="dash-header-left">
        <a href="/" class="dash-brand">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
          </svg>
          <span>WebhookCatch</span>
        </a>
      </div>
      <div class="dash-header-center">
        <div class="url-bar" id="url-bar">
          <code class="url-text text-code" id="webhook-url">Loading…</code>
          <button class="btn-ghost copy-btn" id="copy-url-btn" title="Copy URL">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
          </button>
        </div>
      </div>
      <div class="dash-header-right">
        <div class="session-meta">
          <span class="badge" id="request-count">0 / 100</span>
          <span class="badge" id="expires-badge" title="Time remaining">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span id="countdown">—</span>
          </span>
        </div>
      </div>
    </header>

    <!-- Main Layout -->
    <div class="dash-body">
      <!-- Sidebar: Request List -->
      <aside class="dash-sidebar" id="request-sidebar">
        <div class="sidebar-header">
          <span class="text-caption-mono">Inbox</span>
          <span class="text-caption" style="color: var(--color-mute);" id="total-label">0 requests</span>
        </div>
        <div class="sidebar-list" id="request-list">
          <div class="empty-state" id="empty-state">
            <div class="pulse-indicator">
              <span class="pulse-dot"></span>
            </div>
            <p class="text-body-sm" style="color: var(--color-mute); margin: 8px 0 4px;">Waiting for first request…</p>
            <p class="text-caption" style="color: var(--color-hairline-strong);">Send a request to your webhook URL</p>
          </div>
        </div>
      </aside>

      <!-- Main: Request Detail -->
      <main class="dash-main" id="request-detail">
        <div class="detail-empty" id="detail-empty">
          <div class="detail-empty-inner">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-hairline-strong)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <path d="M3 9h18"/>
              <path d="M9 21V9"/>
            </svg>
            <p class="text-body-md" style="color: var(--color-mute); margin: 16px 0 0;">
              Select a request to inspect
            </p>
          </div>
        </div>

        <div class="detail-content" id="detail-content" style="display: none;">
          <!-- Request Summary -->
          <div class="detail-summary" id="detail-summary">
            <span class="badge-method" id="detail-method">GET</span>
            <span class="text-body-sm" style="color: var(--color-mute);" id="detail-time">—</span>
          </div>

          <!-- Tabs -->
          <div class="detail-tabs">
            <button class="tab active" data-tab="headers" id="tab-headers">Headers</button>
            <button class="tab" data-tab="query" id="tab-query">Query</button>
            <button class="tab" data-tab="body" id="tab-body">Body</button>
          </div>

          <!-- Tab Panels -->
          <div class="tab-panel active" id="panel-headers">
            <table class="kv-table" id="headers-table">
              <thead>
                <tr>
                  <th class="text-caption-mono">Key</th>
                  <th class="text-caption-mono">Value</th>
                </tr>
              </thead>
              <tbody id="headers-tbody"></tbody>
            </table>
          </div>

          <div class="tab-panel" id="panel-query" style="display: none;">
            <table class="kv-table" id="query-table">
              <thead>
                <tr>
                  <th class="text-caption-mono">Key</th>
                  <th class="text-caption-mono">Value</th>
                </tr>
              </thead>
              <tbody id="query-tbody"></tbody>
            </table>
            <div id="query-empty" class="panel-empty text-body-sm" style="display: none; color: var(--color-mute); padding: 24px; text-align: center;">
              No query parameters
            </div>
          </div>

          <div class="tab-panel" id="panel-body" style="display: none;">
            <div id="body-empty" class="panel-empty text-body-sm" style="display: none; color: var(--color-mute); padding: 24px; text-align: center;">
              Empty body
            </div>
            <pre class="code-block" id="body-content" style="display: none;"></pre>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>

<script>
  const app = document.getElementById('dashboard-app')!;
  const sessionId = app.dataset.sessionId!;
  const webhookUrlEl = document.getElementById('webhook-url')!;
  const copyBtn = document.getElementById('copy-url-btn')!;
  const countEl = document.getElementById('request-count')!;
  const countdownEl = document.getElementById('countdown')!;
  const totalLabel = document.getElementById('total-label')!;
  const requestList = document.getElementById('request-list')!;
  const emptyState = document.getElementById('empty-state')!;
  const detailEmpty = document.getElementById('detail-empty')!;
  const detailContent = document.getElementById('detail-content')!;
  const detailMethod = document.getElementById('detail-method')!;
  const detailTime = document.getElementById('detail-time')!;
  const headersTbody = document.getElementById('headers-tbody')!;
  const queryTbody = document.getElementById('query-tbody')!;
  const queryEmpty = document.getElementById('query-empty')!;
  const queryTable = document.getElementById('query-table')!;
  const bodyContent = document.getElementById('body-content')!;
  const bodyEmpty = document.getElementById('body-empty')!;

  // Build webhook URL
  const baseUrl = window.location.origin;
  const webhookUrl = `${baseUrl}/w/${sessionId}`;
  webhookUrlEl.textContent = webhookUrl;

  // Copy URL
  copyBtn.addEventListener('click', async () => {
    await navigator.clipboard.writeText(webhookUrl);
    copyBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
    setTimeout(() => {
      copyBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
    }, 1500);
  });

  // Tabs
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => {
        (p as HTMLElement).style.display = 'none';
        p.classList.remove('active');
      });
      tab.classList.add('active');
      const panelId = `panel-${(tab as HTMLElement).dataset.tab}`;
      const panel = document.getElementById(panelId)!;
      panel.style.display = 'block';
      panel.classList.add('active');
    });
  });

  // State
  let requests: any[] = [];
  let selectedId: number | null = null;
  let expiresAt: number | null = null;

  // Countdown timer
  function updateCountdown() {
    if (!expiresAt) return;
    const remaining = expiresAt - Date.now();
    if (remaining <= 0) {
      countdownEl.textContent = 'Expired';
      return;
    }
    const days = Math.floor(remaining / (1000 * 60 * 60 * 24));
    const hours = Math.floor((remaining % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((remaining % (1000 * 60 * 60)) / (1000 * 60));
    if (days > 0) {
      countdownEl.textContent = `${days}d ${hours}h`;
    } else if (hours > 0) {
      countdownEl.textContent = `${hours}h ${minutes}m`;
    } else {
      countdownEl.textContent = `${minutes}m`;
    }
  }
  setInterval(updateCountdown, 1000);

  // Method color class
  function methodClass(method: string): string {
    return `badge-method badge-method-${method.toLowerCase()}`;
  }

  // Format time
  function formatTime(ts: number): string {
    const d = new Date(ts);
    return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  }

  // Render request list
  function renderList() {
    if (requests.length === 0) {
      emptyState.style.display = 'flex';
      return;
    }
    emptyState.style.display = 'none';

    // Clear existing items (but keep empty-state div)
    const existing = requestList.querySelectorAll('.request-item');
    existing.forEach(el => el.remove());

    requests.forEach((req, index) => {
      const item = document.createElement('button');
      item.className = `request-item ${req.id === selectedId ? 'selected' : ''}`;
      item.dataset.requestId = String(req.id);
      item.innerHTML = `
        <span class="${methodClass(req.method)}">${req.method}</span>
        <span class="request-item-time text-caption">${formatTime(req.created_at)}</span>
      `;
      if (index === 0 && requests.length > (existing?.length ?? 0)) {
        item.style.animation = 'slideInRight 0.2s ease-out';
      }
      item.addEventListener('click', () => selectRequest(req));
      requestList.appendChild(item);
    });
  }

  // Select a request
  function selectRequest(req: any) {
    selectedId = req.id;
    detailEmpty.style.display = 'none';
    detailContent.style.display = 'block';

    // Method badge
    detailMethod.className = methodClass(req.method);
    detailMethod.textContent = req.method;

    // Time
    detailTime.textContent = new Date(req.created_at).toLocaleString();

    // Headers
    headersTbody.innerHTML = '';
    const headers = req.headers || {};
    Object.entries(headers).forEach(([key, value]) => {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td class="text-code">${escapeHtml(key)}</td><td class="text-code">${escapeHtml(value as string)}</td>`;
      headersTbody.appendChild(tr);
    });

    // Query
    const query = req.query || {};
    const queryKeys = Object.keys(query);
    if (queryKeys.length === 0) {
      queryTable.style.display = 'none';
      queryEmpty.style.display = 'block';
    } else {
      queryTable.style.display = 'table';
      queryEmpty.style.display = 'none';
      queryTbody.innerHTML = '';
      queryKeys.forEach(key => {
        const tr = document.createElement('tr');
        tr.innerHTML = `<td class="text-code">${escapeHtml(key)}</td><td class="text-code">${escapeHtml(query[key])}</td>`;
        queryTbody.appendChild(tr);
      });
    }

    // Body
    const body = req.body || '';
    if (!body) {
      bodyContent.style.display = 'none';
      bodyEmpty.style.display = 'block';
    } else {
      bodyEmpty.style.display = 'none';
      bodyContent.style.display = 'block';
      // Try to pretty-print JSON
      try {
        const parsed = JSON.parse(body);
        bodyContent.textContent = JSON.stringify(parsed, null, 2);
      } catch {
        bodyContent.textContent = body;
      }
    }

    // Update selection highlight
    requestList.querySelectorAll('.request-item').forEach(el => {
      el.classList.toggle('selected', (el as HTMLElement).dataset.requestId === String(req.id));
    });
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  // Poll for new requests
  async function fetchRequests() {
    try {
      const res = await fetch(`/api/sessions/${sessionId}/requests`);
      if (!res.ok) return;
      const data = await res.json();

      expiresAt = data.session.expires_at;
      updateCountdown();

      countEl.textContent = `${data.session.request_count} / 100`;
      totalLabel.textContent = `${data.requests.length} request${data.requests.length !== 1 ? 's' : ''}`;

      const oldLength = requests.length;
      requests = data.requests;
      renderList();

      // Auto-select first request if none selected and new requests arrived
      if (selectedId === null && requests.length > 0) {
        selectRequest(requests[0]);
      } else if (selectedId !== null) {
        // Re-render detail if selected request might have changed
        const selected = requests.find((r: any) => r.id === selectedId);
        if (selected) selectRequest(selected);
      }
    } catch (err) {
      console.error('Fetch error:', err);
    }
  }

  // Initial fetch + poll every 3s
  fetchRequests();
  setInterval(fetchRequests, 3000);
</script>

<style>
  /* Dashboard Layout */
  .dashboard {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background-color: var(--color-canvas-soft);
  }

  /* Header */
  .dash-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    padding: 0 16px;
    background-color: var(--color-canvas);
    border-bottom: 1px solid var(--color-hairline);
    flex-shrink: 0;
    gap: 16px;
  }

  .dash-header-left {
    flex-shrink: 0;
  }

  .dash-header-center {
    flex: 1;
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .dash-header-right {
    flex-shrink: 0;
  }

  .dash-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--color-ink);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: -0.28px;
  }

  .url-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    padding: 4px 8px 4px 12px;
    max-width: 500px;
    width: 100%;
  }

  .url-text {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-ink);
    font-size: 13px;
  }

  .session-meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Body */
  .dash-body {
    display: flex;
    flex: 1;
    min-height: 0;
  }

  /* Sidebar */
  .dash-sidebar {
    width: 280px;
    border-right: 1px solid var(--color-hairline);
    background-color: var(--color-canvas);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .sidebar-list {
    flex: 1;
    overflow-y: auto;
    padding: 4px;
  }

  .request-item {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 12px;
    border: none;
    background: transparent;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: background-color 0.1s ease;
    text-align: left;
  }

  .request-item:hover {
    background-color: var(--color-canvas-soft);
  }

  .request-item.selected {
    background-color: var(--color-canvas-soft-2);
  }

  .request-item-time {
    color: var(--color-mute);
    margin-left: auto;
  }

  /* Empty state */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 16px;
    text-align: center;
  }

  .pulse-indicator {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-link);
    animation: pulse-dot 1.5s ease-in-out infinite;
  }

  /* Main content */
  .dash-main {
    flex: 1;
    overflow-y: auto;
    min-width: 0;
  }

  .detail-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .detail-empty-inner {
    text-align: center;
  }

  .detail-content {
    animation: fadeIn 0.2s ease-out;
  }

  .detail-summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 24px;
    border-bottom: 1px solid var(--color-hairline);
    background-color: var(--color-canvas);
  }

  /* Tabs */
  .detail-tabs {
    display: flex;
    gap: 0;
    padding: 0 24px;
    background-color: var(--color-canvas);
    border-bottom: 1px solid var(--color-hairline);
  }

  .tab {
    padding: 10px 16px;
    border: none;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-mute);
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .tab:hover {
    color: var(--color-ink);
  }

  .tab.active {
    color: var(--color-ink);
    border-bottom-color: var(--color-ink);
  }

  /* Tab panels */
  .tab-panel {
    padding: 0;
  }

  .kv-table {
    width: 100%;
    border-collapse: collapse;
  }

  .kv-table th {
    text-align: left;
    padding: 8px 24px;
    background-color: var(--color-canvas-soft);
    border-bottom: 1px solid var(--color-hairline);
    color: var(--color-body);
  }

  .kv-table td {
    padding: 8px 24px;
    border-bottom: 1px solid var(--color-hairline);
    color: var(--color-ink);
    word-break: break-all;
    vertical-align: top;
  }

  .kv-table td:first-child {
    color: var(--color-body);
    width: 240px;
    font-weight: 500;
  }

  .kv-table tr:last-child td {
    border-bottom: none;
  }

  /* Code block in body tab */
  .tab-panel .code-block {
    margin: 16px 24px;
    border-radius: var(--radius-md);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .dash-sidebar {
      width: 100%;
      max-height: 40vh;
      border-right: none;
      border-bottom: 1px solid var(--color-hairline);
    }

    .dash-body {
      flex-direction: column;
    }

    .url-bar {
      max-width: 240px;
    }

    .dash-brand span {
      display: none;
    }
  }
</style>
