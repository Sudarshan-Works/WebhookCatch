---
import Layout from '../layouts/Layout.astro';

const { id } = Astro.params;
---

<Layout title={`WebhookCatch — Session ${id}`} description="Inspect incoming webhook requests in real-time.">
  <div class="dashboard" id="dashboard-app" data-session-id={id}>
    <!-- Top Bar -->
    <header class="dash-header">
      <div class="dash-header-left">
        <a href="/" class="dash-brand">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
          </svg>
          <span class="brand-text">WebhookCatch</span>
        </a>
      </div>
      <div class="dash-header-center">
        <div class="url-bar" id="url-bar">
          <code class="url-text text-code" id="webhook-url">Loading…</code>
          <button class="btn-ghost copy-btn" id="copy-url-btn" title="Copy URL">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
          </button>
        </div>
      </div>
      <div class="dash-header-right">
        <div class="session-meta">
          <span class="badge" id="request-count">0 / 100 requests</span>
          <span class="badge" id="expires-badge" title="Time remaining">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span id="countdown" class="text-caption-mono">—</span>
          </span>
        </div>
      </div>
    </header>

    <!-- Main Layout -->
    <div class="dash-body">
      <!-- Sidebar: Request List -->
      <aside class="dash-sidebar" id="request-sidebar">
        <div class="sidebar-header">
          <span class="text-caption-mono">Inbox</span>
          <span class="text-caption" style="color: var(--color-mute);" id="total-label">0 requests</span>
        </div>
        <div class="sidebar-list" id="request-list">
          <div class="empty-state" id="empty-state">
            <div class="pulse-indicator">
              <span class="pulse-dot"></span>
            </div>
            <p class="text-body-sm-strong" style="color: var(--color-ink); margin: 8px 0 4px;">Waiting for first request</p>
            <p class="text-caption" style="color: var(--color-mute);">Send a request to your webhook URL</p>
          </div>
        </div>
      </aside>

      <!-- Main: Request Detail -->
      <main class="dash-main" id="request-detail">
        <div class="detail-empty" id="detail-empty">
          <div class="detail-empty-card">
            <div class="detail-empty-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <path d="M3 9h18"/>
                <path d="M9 21V9"/>
              </svg>
            </div>
            <h3 class="text-display-sm" style="margin: 0 0 8px;">No request selected</h3>
            <p class="text-body-sm" style="color: var(--color-body); margin: 0;">
              Select a request from the sidebar to inspect its method, headers, and payload.
            </p>
          </div>
        </div>

        <div class="detail-content" id="detail-content" style="display: none;">
          <!-- Request Meta Grid -->
          <div class="detail-meta-grid" id="detail-summary">
            <div class="meta-item">
              <span class="meta-label">Method</span>
              <span class="badge-method" id="detail-method">GET</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Status</span>
              <span class="meta-value text-code" style="color: var(--color-success);">200 OK</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Path</span>
              <span class="meta-value text-code" id="detail-path">/</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Timestamp</span>
              <span class="meta-value" id="detail-time">—</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Content Type</span>
              <span class="meta-value text-code" id="detail-content-type">—</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Size</span>
              <span class="meta-value" id="detail-size">0 B</span>
            </div>
          </div>
          
          <div class="detail-actions" style="padding: 16px 32px; border-bottom: 1px solid var(--color-hairline); display: flex; gap: 8px; background-color: var(--color-canvas);">
            <button class="btn-primary btn-sm" id="btn-edit-replay">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px; vertical-align:text-bottom;"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
              Edit & Replay
            </button>
            <button class="btn-ghost btn-sm" id="btn-replay">Replay</button>
          </div>

          <!-- Tabs -->
          <div class="detail-tabs-container">
            <div class="detail-tabs">
              <button class="tab-ghost active" data-tab="body" id="tab-body">Body</button>
              <button class="tab-ghost" data-tab="headers" id="tab-headers">Headers</button>
              <button class="tab-ghost" data-tab="query" id="tab-query">Query Params</button>
              <button class="tab-ghost" data-tab="raw" id="tab-raw">Raw</button>
            </div>
          </div>

          <!-- Tab Panels -->
          <div class="tab-panel active" id="panel-body">
            <div class="panel-content">
              <div id="body-empty" class="panel-empty" style="display: none;">
                <p class="text-body-sm" style="color: var(--color-mute);">No body payload found in this request.</p>
              </div>
              <div class="code-editor-mockup" id="body-container" style="display: none;">
                <div class="code-editor-header" style="justify-content: space-between;">
                  <div style="display: flex; gap: 8px; align-items: center;">
                    <span class="code-editor-dot" style="background-color: #ff5f56;"></span>
                    <span class="code-editor-dot" style="background-color: #ffbd2e;"></span>
                    <span class="code-editor-dot" style="background-color: #27c93f;"></span>
                  </div>
                  <div class="code-actions" style="display: flex; gap: 8px;">
                    <button class="btn-ghost btn-sm" id="btn-copy-json">Copy JSON</button>
                    <button class="btn-ghost btn-sm" id="btn-copy-curl">Copy as cURL</button>
                  </div>
                </div>
                <pre style="margin: 0;"><code class="code-content text-code language-json" id="body-content" style="padding: 24px; display: block; overflow-x: auto;"></code></pre>
              </div>
            </div>
          </div>

          <div class="tab-panel" id="panel-headers" style="display: none;">
            <div class="panel-content">
              <table class="kv-table" id="headers-table">
                <thead>
                  <tr>
                    <th class="text-caption-mono">Header</th>
                    <th class="text-caption-mono">Value</th>
                  </tr>
                </thead>
                <tbody id="headers-tbody"></tbody>
              </table>
            </div>
          </div>

          <div class="tab-panel" id="panel-query" style="display: none;">
            <div class="panel-content">
              <table class="kv-table" id="query-table">
                <thead>
                  <tr>
                    <th class="text-caption-mono">Parameter</th>
                    <th class="text-caption-mono">Value</th>
                  </tr>
                </thead>
                <tbody id="query-tbody"></tbody>
              </table>
              <div id="query-empty" class="panel-empty" style="display: none;">
                <p class="text-body-sm" style="color: var(--color-mute);">No query parameters found in this request.</p>
              </div>
            </div>
          </div>

          <div class="tab-panel" id="panel-raw" style="display: none;">
            <div class="panel-content">
              <div class="code-editor-mockup">
                <div class="code-editor-header">
                  <span class="code-editor-dot" style="background-color: #ff5f56;"></span>
                  <span class="code-editor-dot" style="background-color: #ffbd2e;"></span>
                  <span class="code-editor-dot" style="background-color: #27c93f;"></span>
                </div>
                <pre class="code-content text-code" id="raw-content" style="margin:0;"></pre>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Replay Modal -->
  <div id="replay-modal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="text-body-md" style="font-weight: 600;">Edit & Replay</h3>
        <button class="btn-ghost btn-sm" id="btn-close-modal" style="padding: 4px;">✕</button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label class="meta-label">Destination URL</label>
          <div style="display: flex; gap: 8px;">
            <select class="input-select text-code" id="replay-method">
              <option>GET</option>
              <option>POST</option>
              <option>PUT</option>
              <option>PATCH</option>
              <option>DELETE</option>
            </select>
            <input type="text" class="input-text text-code" id="replay-url" placeholder="https://your-server.com/webhook" style="flex: 1;" />
          </div>
        </div>
        <div class="form-group">
          <label class="meta-label">Headers (JSON format)</label>
          <textarea class="input-textarea text-code" id="replay-headers" rows="2" style="font-size:12px;"></textarea>
        </div>
        <div class="form-group">
          <label class="meta-label">Query Params (JSON format)</label>
          <textarea class="input-textarea text-code" id="replay-query" rows="2" style="font-size:12px;"></textarea>
        </div>
        <div class="form-group">
          <label class="meta-label">Body</label>
          <textarea class="input-textarea text-code" id="replay-body" rows="4" style="font-size:12px;"></textarea>
        </div>
      </div>
      
      <div class="modal-response" id="replay-response-section" style="display: none;">
        <div style="display: flex; gap: 16px; margin-bottom: 8px; align-items: center; padding: 0 24px;">
          <span class="meta-label">Response</span>
          <span class="badge" id="replay-res-status"></span>
          <span class="text-caption-mono" id="replay-res-time" style="color:var(--color-mute);"></span>
        </div>
        <div style="padding: 0 24px 24px;">
          <pre class="code-editor-mockup"><code class="code-content text-code" id="replay-res-body" style="padding: 16px; display: block; max-height: 200px; overflow-y: auto;"></code></pre>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn-primary" id="btn-send-replay" style="width: 100%;">Send Request</button>
      </div>
    </div>
  </div>
</Layout>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/json.min.js"></script>
<script>
  const app = document.getElementById('dashboard-app')!;
  const sessionId = app.dataset.sessionId!;
  const webhookUrlEl = document.getElementById('webhook-url')!;
  const copyBtn = document.getElementById('copy-url-btn')!;
  const countEl = document.getElementById('request-count')!;
  const countdownEl = document.getElementById('countdown')!;
  const totalLabel = document.getElementById('total-label')!;
  const requestList = document.getElementById('request-list')!;
  const emptyState = document.getElementById('empty-state')!;
  const detailEmpty = document.getElementById('detail-empty')!;
  const detailContent = document.getElementById('detail-content')!;
  const detailMethod = document.getElementById('detail-method')!;
  const detailPath = document.getElementById('detail-path')!;
  const detailTime = document.getElementById('detail-time')!;
  const detailContentType = document.getElementById('detail-content-type')!;
  const detailSize = document.getElementById('detail-size')!;
  const headersTbody = document.getElementById('headers-tbody')!;
  const rawContent = document.getElementById('raw-content')!;
  const btnCopyJson = document.getElementById('btn-copy-json')!;
  const btnCopyCurl = document.getElementById('btn-copy-curl')!;
  const btnReplay = document.getElementById('btn-replay')!;
  const btnEditReplay = document.getElementById('btn-edit-replay')!;
  const queryTbody = document.getElementById('query-tbody')!;
  const queryEmpty = document.getElementById('query-empty')!;
  const queryTable = document.getElementById('query-table')!;
  const bodyContainer = document.getElementById('body-container')!;
  const bodyContent = document.getElementById('body-content')!;
  const bodyEmpty = document.getElementById('body-empty')!;

  // Build webhook URL
  const baseUrl = window.location.origin;
  const webhookUrl = `${baseUrl}/w/${sessionId}`;
  webhookUrlEl.textContent = webhookUrl;

  // Copy URL
  copyBtn.addEventListener('click', async () => {
    await navigator.clipboard.writeText(webhookUrl);
    copyBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
    setTimeout(() => {
      copyBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
    }, 2000);
  });

  // Tabs
  document.querySelectorAll('.tab-ghost').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.tab-ghost').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => {
        (p as HTMLElement).style.display = 'none';
        p.classList.remove('active');
      });
      tab.classList.add('active');
      const panelId = `panel-${(tab as HTMLElement).dataset.tab}`;
      const panel = document.getElementById(panelId)!;
      panel.style.display = 'block';
      setTimeout(() => panel.classList.add('active'), 10); // for fade in
    });
  });

  // State
  let requests: any[] = [];
  let selectedId: number | null = null;
  let expiresAt: number | null = null;

  // Countdown timer
  function updateCountdown() {
    if (!expiresAt) return;
    const remaining = expiresAt - Date.now();
    if (remaining <= 0) {
      countdownEl.textContent = '00:00:00';
      return;
    }
    const days = Math.floor(remaining / (1000 * 60 * 60 * 24));
    const hours = Math.floor((remaining % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((remaining % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((remaining % (1000 * 60)) / 1000);
    
    if (days > 0) {
      countdownEl.textContent = `${days}d ${hours}h`;
    } else {
      countdownEl.textContent = `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
    }
  }
  setInterval(updateCountdown, 1000);

  // Replay Logic
  const replayModal = document.getElementById('replay-modal')!;
  const btnCloseModal = document.getElementById('btn-close-modal')!;
  const btnSendReplay = document.getElementById('btn-send-replay')!;
  const replayMethod = document.getElementById('replay-method') as HTMLSelectElement;
  const replayUrl = document.getElementById('replay-url') as HTMLInputElement;
  const replayHeaders = document.getElementById('replay-headers') as HTMLTextAreaElement;
  const replayQuery = document.getElementById('replay-query') as HTMLTextAreaElement;
  const replayBody = document.getElementById('replay-body') as HTMLTextAreaElement;
  const replayResSection = document.getElementById('replay-response-section')!;
  const replayResStatus = document.getElementById('replay-res-status')!;
  const replayResTime = document.getElementById('replay-res-time')!;
  const replayResBody = document.getElementById('replay-res-body')!;

  let lastReplayUrl = '';

  function openReplayModal(autoSend = false) {
    const req = requests.find(r => r.id === selectedId);
    if (!req) return;

    replayMethod.value = req.method;
    replayUrl.value = lastReplayUrl || `${baseUrl}${req.path || '/w/' + sessionId}`;
    replayHeaders.value = JSON.stringify(req.headers || {}, null, 2);
    replayQuery.value = JSON.stringify(req.query || {}, null, 2);
    replayBody.value = req.body || '';
    
    replayResSection.style.display = 'none';
    replayModal.style.display = 'flex';
    
    if (autoSend) {
      executeReplay();
    }
  }

  btnCloseModal.onclick = () => replayModal.style.display = 'none';
  btnEditReplay.onclick = () => openReplayModal(false);
  btnReplay.onclick = () => openReplayModal(true);
  
  async function executeReplay() {
    lastReplayUrl = replayUrl.value;
    btnSendReplay.textContent = 'Sending...';
    btnSendReplay.disabled = true;
    replayResSection.style.display = 'none';

    try {
      const payload = {
        url: replayUrl.value,
        method: replayMethod.value,
        headers: JSON.parse(replayHeaders.value || '{}'),
        query: JSON.parse(replayQuery.value || '{}'),
        body: replayBody.value
      };

      const res = await fetch(`/api/sessions/${sessionId}/replay`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();

      replayResSection.style.display = 'block';
      if (data.error) {
        replayResStatus.textContent = 'Error';
        replayResStatus.className = 'badge badge-method-delete';
        replayResBody.textContent = data.error;
        replayResTime.textContent = data.timeMs ? `${data.timeMs}ms` : '';
      } else {
        replayResStatus.textContent = `${data.status} ${data.statusText}`;
        replayResStatus.className = data.success ? 'badge badge-method-get' : 'badge badge-method-delete';
        replayResTime.textContent = `${data.timeMs}ms`;
        replayResBody.textContent = data.body || '[Empty]';
      }
    } catch (err: any) {
      replayResSection.style.display = 'block';
      replayResStatus.textContent = 'Network Error';
      replayResStatus.className = 'badge badge-method-delete';
      replayResBody.textContent = err.message || String(err);
    } finally {
      btnSendReplay.textContent = 'Send Request';
      btnSendReplay.disabled = false;
    }
  }

  btnSendReplay.onclick = executeReplay;

  // Method color class
  function methodClass(method: string): string {
    return `badge-method badge-method-${method.toLowerCase()}`;
  }

  // Format time relative or absolute
  function formatTimeShort(ts: number): string {
    const d = new Date(ts);
    return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  }

  // Render request list
  function renderList() {
    if (requests.length === 0) {
      emptyState.style.display = 'flex';
      return;
    }
    emptyState.style.display = 'none';

    // Clear existing items (but keep empty-state div)
    const existing = requestList.querySelectorAll('.request-item');
    existing.forEach(el => el.remove());

    requests.forEach((req, index) => {
      const item = document.createElement('button');
      item.className = `request-item ${req.id === selectedId ? 'selected' : ''}`;
      item.dataset.requestId = String(req.id);
      
      item.innerHTML = `
        <div class="request-item-indicator"></div>
        <div class="request-item-content">
          <div class="request-item-top">
            <span class="${methodClass(req.method)}">${req.method}</span>
            <span class="request-item-time text-caption">${formatTimeShort(req.created_at)}</span>
          </div>
        </div>
      `;
      if (index === 0 && requests.length > (existing?.length ?? 0)) {
        item.style.animation = 'slideInRight 0.3s cubic-bezier(0.16, 1, 0.3, 1)';
      }
      item.addEventListener('click', () => selectRequest(req));
      requestList.appendChild(item);
    });
  }

  // Select a request
  function selectRequest(req: any) {
    selectedId = req.id;
    detailEmpty.style.display = 'none';
    detailContent.style.display = 'flex';

    // Method & Path
    detailMethod.className = methodClass(req.method);
    detailMethod.textContent = req.method;
    detailPath.textContent = req.path || '/';

    // Time
    const d = new Date(req.created_at);
    detailTime.textContent = d.toLocaleString(undefined, {
      month: 'short', day: 'numeric', year: 'numeric',
      hour: '2-digit', minute: '2-digit', second: '2-digit', fractionalSecondDigits: 3
    });

    // Headers
    headersTbody.innerHTML = '';
    const headers = req.headers || {};
    Object.entries(headers).forEach(([key, value]) => {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td class="text-code">${escapeHtml(key)}</td><td class="text-code">${escapeHtml(value as string)}</td>`;
      headersTbody.appendChild(tr);
    });

    // Content Type & Size
    const contentType = Object.keys(headers).find(k => k.toLowerCase() === 'content-type');
    detailContentType.textContent = contentType ? headers[contentType] : 'None';
    
    const bodySize = req.body ? new Blob([req.body]).size : 0;
    detailSize.textContent = bodySize < 1024 ? `${bodySize} B` : `${(bodySize/1024).toFixed(2)} KB`;

    // Query
    const query = req.query || {};
    const queryKeys = Object.keys(query);
    if (queryKeys.length === 0) {
      queryTable.style.display = 'none';
      queryEmpty.style.display = 'flex';
    } else {
      queryTable.style.display = 'table';
      queryEmpty.style.display = 'none';
      queryTbody.innerHTML = '';
      queryKeys.forEach(key => {
        const tr = document.createElement('tr');
        tr.innerHTML = `<td class="text-code">${escapeHtml(key)}</td><td class="text-code">${escapeHtml(query[key])}</td>`;
        queryTbody.appendChild(tr);
      });
    }

    // Body
    const body = req.body || '';
    if (!body) {
      bodyContainer.style.display = 'none';
      bodyEmpty.style.display = 'flex';
      btnCopyJson.style.display = 'none';
    } else {
      bodyEmpty.style.display = 'none';
      bodyContainer.style.display = 'block';
      // Try to pretty-print JSON
      let formattedJson = body;
      let isJson = false;
      try {
        const parsed = JSON.parse(body);
        formattedJson = JSON.stringify(parsed, null, 2);
        isJson = true;
      } catch {}
      
      bodyContent.textContent = formattedJson;
      // @ts-ignore
      if (window.hljs && isJson) {
        // @ts-ignore
        bodyContent.dataset.highlighted = ''; // reset highlight.js flag
        // @ts-ignore
        hljs.highlightElement(bodyContent);
      }
      
      btnCopyJson.style.display = isJson ? 'inline-flex' : 'none';
      btnCopyJson.onclick = () => {
        navigator.clipboard.writeText(formattedJson);
        const orig = btnCopyJson.textContent;
        btnCopyJson.textContent = 'Copied!';
        setTimeout(() => btnCopyJson.textContent = orig, 2000);
      };
    }
    
    // Copy as cURL
    btnCopyCurl.onclick = () => {
      let curl = `curl -X ${req.method} "${baseUrl}${req.path || '/w/' + sessionId}"`;
      for (const [key, val] of Object.entries(headers)) {
        curl += ` \\\n  -H "${key}: ${val}"`;
      }
      if (body) {
        const escapedBody = body.replace(/"/g, '\\"');
        curl += ` \\\n  -d "${escapedBody}"`;
      }
      navigator.clipboard.writeText(curl);
      const orig = btnCopyCurl.textContent;
      btnCopyCurl.textContent = 'Copied!';
      setTimeout(() => btnCopyCurl.textContent = orig, 2000);
    };

    // Raw
    let rawStr = `${req.method} ${req.path || '/'} HTTP/1.1\r\n`;
    for (const [key, val] of Object.entries(headers)) {
      rawStr += `${key}: ${val}\r\n`;
    }
    rawStr += `\r\n`;
    rawStr += body;
    rawContent.textContent = rawStr;

    // Update selection highlight
    requestList.querySelectorAll('.request-item').forEach(el => {
      el.classList.toggle('selected', (el as HTMLElement).dataset.requestId === String(req.id));
    });
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  // Listen for real-time updates via SSE
  let eventSource: EventSource | null = null;

  function connectStream() {
    if (eventSource) {
      eventSource.close();
    }
    
    eventSource = new EventSource(`/api/sessions/${sessionId}/stream`);
    
    eventSource.onmessage = (event) => {
      try {
        const data = JSON.parse(event.data);
        
        expiresAt = data.session.expires_at;
        updateCountdown();

        countEl.textContent = `${data.session.request_count} / 100 requests`;
        totalLabel.textContent = `${data.requests.length} request${data.requests.length !== 1 ? 's' : ''}`;

        requests = data.requests;
        renderList();

        // Auto-select first request if none selected and new requests arrived
        if (selectedId === null && requests.length > 0) {
          selectRequest(requests[0]);
        } else if (selectedId !== null) {
          // Re-render detail if selected request might have changed
          const selected = requests.find((r: any) => r.id === selectedId);
          if (selected) selectRequest(selected);
        }
      } catch (err) {
        console.error('Error parsing stream data:', err);
      }
    };
    
    eventSource.addEventListener('error', (event: any) => {
      if (event.data) {
        console.warn('Stream error:', event.data);
        // Do not auto-reconnect if it's a hard error (like session expired)
        eventSource?.close();
      }
      // Note: EventSource automatically handles normal network reconnects
    });
  }

  connectStream();
</script>

