---
import Layout from '../layouts/Layout.astro';

interface Props {
  error?: unknown;
}

const { error } = Astro.props;
---

<Layout title="500: Server Error | WebhookCatch" description="An unexpected server error occurred.">
  <main class="page-container" style="min-height: 80vh; display: flex; align-items: center; justify-content: center;">
    <div class="content-wrapper" style="text-align: center; max-width: 600px;">
      <div class="hero-badge" style="margin: 0 auto 24px; border-color: var(--color-error-soft); background-color: rgba(255, 95, 86, 0.1);">
        <span class="pulse-dot" style="background-color: var(--color-error); box-shadow: 0 0 0 0 rgba(255, 95, 86, 0.7);"></span>
        <span class="text-caption-mono" style="color: var(--color-error);">Error 500</span>
      </div>
      
      <h1 class="hero-title">
        Internal Server <span class="gradient-text" style="background: linear-gradient(135deg, #ff5f56 0%, #ff2a2a 100%); -webkit-background-clip: text;">Error</span>
      </h1>
      
      <p class="hero-subtitle" style="margin-bottom: 40px;">
        Whoops! Something went wrong on our end. We've logged the error and will look into it.
      </p>

      <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn-primary" style="background-color: var(--color-error);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          Return Home
        </a>
        <a href="/contact" class="btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          Report Issue
        </a>
      </div>
      
      <div class="code-editor-mockup" style="margin-top: 48px; text-align: left;">
        <div class="code-editor-header">
          <span class="code-editor-dot" style="background-color: #ff5f56;"></span>
          <span class="code-editor-dot" style="background-color: #ffbd2e;"></span>
          <span class="code-editor-dot" style="background-color: #27c93f;"></span>
        </div>
        <pre><code class="text-code" style="color: var(--color-error);">500 Internal Server Error</code>
<code class="text-code" style="color: var(--color-body);">{"{"}
  "status": "error",
  "message": "The server encountered an unexpected condition that prevented it from fulfilling the request.",
  "incident_id": "{Math.random().toString(36).substring(2, 10).toUpperCase()}"
{"}"}</code></pre>
      </div>
    </div>
  </main>
</Layout>

<style>
  @keyframes errorPulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 95, 86, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(255, 95, 86, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 95, 86, 0); }
  }
  .pulse-dot[style*="var(--color-error)"] {
    animation: errorPulse 2s infinite;
  }
</style>
