---
import SEOLayout from '../layouts/SEOLayout.astro';
const title = "Contact Us & Support - WebhookCatch";
const description = "Contact the WebhookCatch team for support, feature requests, or bug reports.";
---

<SEOLayout title={title} description={description}>
  <main style="max-width: 600px; margin: 0 auto; padding: 100px 24px; color: var(--color-ink);">
    <h1 class="text-heading-1" style="margin-bottom: 16px; font-weight: 700;">Contact Support</h1>
    <p class="text-body" style="color: var(--color-body); margin-bottom: 48px;">
      Have a question, found a bug, or need help? Send us a message and we'll get back to you at <strong>contact@webhookcatch.com</strong>.
    </p>

    <form id="contact-form" style="display: flex; flex-direction: column; gap: 24px; background: var(--color-surface); padding: 32px; border-radius: 12px; border: 1px solid var(--color-hairline); box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
      
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <label for="email" class="text-body-sm" style="font-weight: 600;">Your Email Address *</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          required 
          placeholder="you@example.com"
          style="padding: 12px 16px; border-radius: 8px; border: 1px solid var(--color-hairline); background: var(--color-bg); color: var(--color-ink); font-family: inherit; font-size: 14px;"
        />
      </div>

      <div style="display: flex; flex-direction: column; gap: 8px;">
        <label for="query" class="text-body-sm" style="font-weight: 600;">How can we help? *</label>
        <textarea 
          id="query" 
          name="query" 
          required 
          rows="5"
          placeholder="Describe your issue or question..."
          style="padding: 12px 16px; border-radius: 8px; border: 1px solid var(--color-hairline); background: var(--color-bg); color: var(--color-ink); font-family: inherit; font-size: 14px; resize: vertical;"
        ></textarea>
      </div>

      <div style="display: flex; flex-direction: column; gap: 8px;">
        <label for="screenshot" class="text-body-sm" style="font-weight: 600;">Attach a Screenshot (Optional)</label>
        <div style="position: relative;">
          <input 
            type="file" 
            id="screenshot" 
            name="screenshot" 
            accept="image/png, image/jpeg, image/webp"
            style="width: 100%; padding: 10px; border-radius: 8px; border: 1px dashed var(--color-primary); background: rgba(59, 130, 246, 0.05); color: var(--color-ink); font-size: 14px; cursor: pointer;"
          />
        </div>
        <p class="text-body-sm" style="color: var(--color-gray-500); margin: 0; font-size: 12px;">Max size 2MB. Useful for bug reports.</p>
      </div>

      <button 
        type="submit" 
        id="submit-btn"
        class="btn-primary" 
        style="width: 100%; justify-content: center; margin-top: 8px;"
      >
        Send Message
      </button>

      <div id="form-error" class="text-body-sm" style="color: #ef4444; display: none; text-align: center;"></div>
    </form>
  </main>

  </SEOLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const fileInput = document.getElementById('screenshot') as HTMLInputElement;
  const errorMsg = document.getElementById('form-error') as HTMLDivElement;

  function toBase64(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.readAsDataURL(file);
      reader.onload = () => {
        if (typeof reader.result === 'string') {
          // Extract just the base64 part, removing the data:image/png;base64, prefix
          const base64 = reader.result.split(',')[1];
          resolve(base64 || '');
        } else {
          resolve('');
        }
      };
      reader.onerror = error => reject(error);
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.style.display = 'none';
    
    const email = (document.getElementById('email') as HTMLInputElement).value;
    const query = (document.getElementById('query') as HTMLTextAreaElement).value;
    
    let base64Image = '';
    let mimeType = '';
    let fileName = '';

    const file = fileInput?.files?.[0];
    if (file) {
      if (file.size > 2 * 1024 * 1024) {
        errorMsg.textContent = 'Image size must be less than 2MB.';
        errorMsg.style.display = 'block';
        return;
      }
      try {
        base64Image = await toBase64(file);
        mimeType = file.type;
        fileName = file.name;
      } catch (err) {
        errorMsg.textContent = 'Failed to read image file.';
        errorMsg.style.display = 'block';
        return;
      }
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';

    try {
      const res = await fetch('/api/support', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          query,
          screenshot: base64Image ? {
            content: base64Image,
            filename: fileName,
            type: mimeType
          } : null
        })
      });

      const data = await res.json() as any;

      if (!res.ok) {
        throw new Error(data.error || 'Failed to send message');
      }

      // Success
      (window as any).showToast('Message sent successfully!');
      form.reset();
    } catch (err: any) {
      errorMsg.textContent = err.message || 'An unexpected error occurred.';
      errorMsg.style.display = 'block';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Message';
    }
  });
</script>

<style>
  @media (max-width: 768px) {
    main { padding-top: 80px !important; padding-left: 16px !important; padding-right: 16px !important; }
  }
</style>
