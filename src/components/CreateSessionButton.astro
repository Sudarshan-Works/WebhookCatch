---
import { env } from 'cloudflare:workers';

export interface Props {
  text?: string;
}

const { text = "Create Webhook URL" } = Astro.props;
const turnstileSiteKey = (env as any).TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
---

<div class="create-session-wrapper" style="display: flex; flex-direction: column; align-items: center; gap: 16px;">
  <button id="create-webhook-btn" class="btn-primary" type="button">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
    </svg>
    <span id="create-btn-text">{text}</span>
    <svg id="create-btn-spinner" class="spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none; width: 18px; height: 18px;">
      <line x1="12" y1="2" x2="12" y2="6"></line>
      <line x1="12" y1="18" x2="12" y2="22"></line>
      <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line>
      <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line>
      <line x1="2" y1="12" x2="6" y2="12"></line>
      <line x1="18" y1="12" x2="22" y2="12"></line>
      <line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line>
      <line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line>
    </svg>
  </button>
  <div id="turnstile-container" style="display: none;"></div>
</div>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
<script define:vars={{ turnstileSiteKey }}>
  const btn = document.getElementById('create-webhook-btn');
  const btnText = document.getElementById('create-btn-text');
  const btnSpinner = document.getElementById('create-btn-spinner');
  const originalText = btnText ? btnText.textContent : 'Create Webhook URL';

  if (btn && btnText && btnSpinner) {
    btn.addEventListener('click', async () => {
      btn.setAttribute('disabled', 'true');
      btn.style.opacity = '0.7';
      btn.style.cursor = 'wait';
      btnText.textContent = 'Creating…';
      btnSpinner.style.display = 'block';
      const icon = btn.querySelector('svg:not(.spinner)');
      if (icon) (icon.style.display = 'none');

      try {
        const res = await fetch('/api/sessions', { method: 'POST' });
        const data = await res.json();
        
        if (res.status === 201 && data.id) {
          window.location.href = `/${data.id}`;
        } else if (res.status === 403 && data.error === "Challenge Required") {
          // Render Turnstile
          const siteKey = turnstileSiteKey;
          document.getElementById('turnstile-container').style.display = 'block';
          btn.style.display = 'none';
          
          if (window.turnstile) {
            window.turnstile.render('#turnstile-container', {
              sitekey: siteKey,
              callback: async function(token) {
                // Retry session creation with token
                const retryRes = await fetch('/api/sessions', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ turnstileToken: token })
                });
                const retryData = await retryRes.json();
                if (retryData.id) {
                  window.location.href = `/${retryData.id}`;
                } else {
                  alert("Failed to verify challenge. Please try again.");
                  window.turnstile.reset();
                }
              }
            });
          }
        } else {
          alert(data.error || "Failed to create session");
          throw new Error(data.error || "Failed");
        }
      } catch (err) {
        btn.removeAttribute('disabled');
        btn.style.opacity = '1';
        btn.style.cursor = 'pointer';
        btnText.textContent = originalText;
        btnSpinner.style.display = 'none';
        if (icon) (icon.style.display = 'block');
        console.error('Failed to create session', err);
      }
    });
  }
</script>
