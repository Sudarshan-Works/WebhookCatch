---
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { 
  title, 
  description = "Instantly generate a unique webhook URL to test, inspect, and debug incoming HTTP requests in real-time. No signup required.",
  noindex = false 
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <SEO 
      title={title}
      description={description}
      noindex={noindex}
    />

    <!-- Fonts: Geist Sans + Geist Mono -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-sans/style.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-mono/style.min.css"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/app.css";
</style>
